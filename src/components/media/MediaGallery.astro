---
import type { MediaItem } from '../../data/about';

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
---

<div class="media-gallery">
  {items.map((item) => (
    <figure class="media-gallery__item">
      {item.type === 'video' ? (
        <video autoplay muted loop playsinline preload="metadata" aria-label={item.alt}>
          <source src={item.src} type="video/mp4" />
        </video>
      ) : (
        <img src={item.src} alt={item.alt} loading="lazy" />
      )}
    </figure>
  ))}
</div>

<style>
  .media-gallery {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: var(--space-3);
  }

  .media-gallery__item {
    flex: 0 0 auto;
    width: clamp(14rem, 28vw, 19rem);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--surface-muted);
    margin: 0;
  }

  .media-gallery__item img,
  .media-gallery__item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
