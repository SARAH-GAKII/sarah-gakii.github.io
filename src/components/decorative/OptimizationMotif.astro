---
// Decorative SVG: a loss-landscape contour plot with a gradient-descent path
// converging on a minimum. Purely decorative — hidden from assistive tech.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['optimization-motif', className]}
  viewBox="0 0 640 480"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <g class="optimization-motif__contours" stroke-width="1.1">
    <ellipse cx="460" cy="170" rx="230" ry="180" transform="rotate(-6 460 170)" />
    <ellipse cx="460" cy="170" rx="175" ry="135" transform="rotate(-8 460 170)" />
    <ellipse cx="460" cy="170" rx="125" ry="95" transform="rotate(-10 460 170)" />
    <ellipse cx="460" cy="170" rx="80" ry="60" transform="rotate(-12 460 170)" />
    <ellipse cx="460" cy="170" rx="40" ry="30" transform="rotate(-12 460 170)" />
  </g>

  <polyline
    class="optimization-motif__path"
    points="150,380 230,340 270,260 330,230 365,195 410,178 438,172 460,170"
    stroke-width="1.5"
    stroke-dasharray="2 7"
    stroke-linecap="round"
  />

  <g class="optimization-motif__steps">
    <circle cx="230" cy="340" r="3" />
    <circle cx="270" cy="260" r="3" />
    <circle cx="330" cy="230" r="3" />
    <circle cx="365" cy="195" r="3" />
    <circle cx="410" cy="178" r="3" />
    <circle cx="438" cy="172" r="3" />
  </g>

  <circle class="optimization-motif__minimum" cx="460" cy="170" r="5" />
</svg>

<style>
  .optimization-motif {
    width: 100%;
    height: 100%;
  }

  .optimization-motif__contours ellipse {
    stroke: currentColor;
    opacity: 0.22;
  }

  .optimization-motif__path {
    stroke: currentColor;
    opacity: 0.4;
    fill: none;
  }

  .optimization-motif__steps circle {
    fill: currentColor;
    opacity: 0.4;
  }

  .optimization-motif__minimum {
    fill: var(--accent-on-dark);
    opacity: 0.9;
  }
</style>
