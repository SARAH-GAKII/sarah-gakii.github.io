---
// Decorative SVG: a sparse graph of nodes and edges, evoking network/graph-theory
// structure. Purely decorative — hidden from assistive tech.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const nodes = [
  { id: 'n1', x: 470, y: 80 },
  { id: 'n2', x: 560, y: 60 },
  { id: 'n3', x: 610, y: 150 },
  { id: 'n4', x: 540, y: 190 },
  { id: 'n5', x: 430, y: 170 },
  { id: 'n6', x: 480, y: 270 },
  { id: 'n7', x: 560, y: 290 },
  { id: 'n8', x: 380, y: 250 },
];

const edges: [string, string][] = [
  ['n1', 'n2'],
  ['n1', 'n5'],
  ['n2', 'n3'],
  ['n3', 'n4'],
  ['n4', 'n5'],
  ['n4', 'n7'],
  ['n5', 'n6'],
  ['n6', 'n7'],
  ['n6', 'n8'],
  ['n5', 'n8'],
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
---

<svg
  class:list={['network-motif', className]}
  viewBox="0 0 640 480"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <g class="network-motif__edges" stroke-width="1">
    {edges.map(([a, b]) => (
      <line x1={byId[a].x} y1={byId[a].y} x2={byId[b].x} y2={byId[b].y} />
    ))}
  </g>

  <g class="network-motif__nodes">
    {nodes.map((n) => (
      <circle cx={n.x} cy={n.y} r={n.id === 'n4' ? 6 : 3.5} class={n.id === 'n4' ? 'is-hub' : ''} />
    ))}
  </g>
</svg>

<style>
  .network-motif {
    width: 100%;
    height: 100%;
  }

  .network-motif__edges line {
    stroke: currentColor;
    opacity: 0.28;
  }

  .network-motif__nodes circle {
    fill: currentColor;
    opacity: 0.5;
  }

  .network-motif__nodes circle.is-hub {
    fill: var(--accent-on-dark);
    opacity: 0.95;
  }
</style>
