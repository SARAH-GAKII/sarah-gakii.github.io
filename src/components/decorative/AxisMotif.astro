---
// Decorative SVG: a coordinate axis with a scattered vector field and a single
// trajectory curve threading through it. Purely decorative — hidden from assistive tech.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const field = [
  { x: 120, y: 90, dx: 18, dy: 10 },
  { x: 200, y: 60, dx: 22, dy: 4 },
  { x: 300, y: 100, dx: 20, dy: -8 },
  { x: 400, y: 70, dx: 16, dy: -14 },
  { x: 150, y: 190, dx: 22, dy: -4 },
  { x: 260, y: 210, dx: 18, dy: -12 },
  { x: 360, y: 180, dx: 14, dy: -18 },
  { x: 460, y: 150, dx: 10, dy: -20 },
  { x: 180, y: 300, dx: 20, dy: -10 },
  { x: 290, y: 320, dx: 16, dy: -16 },
  { x: 400, y: 290, dx: 12, dy: -20 },
  { x: 500, y: 250, dx: 8, dy: -22 },
];
---

<svg
  class:list={['axis-motif', className]}
  viewBox="0 0 640 480"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <g class="axis-motif__axes" stroke-width="1.1">
    <line x1="90" y1="420" x2="90" y2="40" />
    <line x1="90" y1="420" x2="560" y2="420" />
    <polyline points="82,56 90,40 98,56" />
    <polyline points="544,412 560,420 544,428" />
  </g>

  <g class="axis-motif__field" stroke-width="1.1" stroke-linecap="round">
    {field.map((v) => (
      <line x1={v.x} y1={v.y} x2={v.x + v.dx} y2={v.y + v.dy} />
    ))}
  </g>

  <path
    class="axis-motif__curve"
    d="M110,400 C 180,340 210,260 260,230 C 320,195 360,150 430,110 C 470,88 500,80 540,78"
    stroke-width="1.6"
  />

  <circle class="axis-motif__point" cx="540" cy="78" r="4.5" />
</svg>

<style>
  .axis-motif {
    width: 100%;
    height: 100%;
  }

  .axis-motif__axes line,
  .axis-motif__axes polyline {
    stroke: currentColor;
    opacity: 0.3;
  }

  .axis-motif__field line {
    stroke: currentColor;
    opacity: 0.24;
  }

  .axis-motif__curve {
    stroke: currentColor;
    opacity: 0.5;
    fill: none;
  }

  .axis-motif__point {
    fill: currentColor;
    opacity: 0.9;
  }
</style>
