---
interface Props {
  title: string;
  meta: string;
  description: string;
  courses: string;
}

const { title, meta, description, courses } = Astro.props;
---

<details class="edu-card">
  <summary>
    <span class="edu-card__title">{title}</span>
    <span class="edu-card__meta">{meta}</span>
  </summary>
  <div class="edu-card__body">
    <p>{description}</p>
    <p><strong>Selected coursework:</strong> {courses}</p>
  </div>
</details>

<style>
  .edu-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent-primary);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .edu-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .edu-card summary {
    list-style: none;
    cursor: pointer;
    position: relative;
    padding: var(--space-5) var(--space-10) var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .edu-card summary::-webkit-details-marker {
    display: none;
  }

  .edu-card summary::after {
    content: '+';
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--accent);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .edu-card summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .edu-card[open] summary::after {
    content: '\2212';
    background: var(--accent);
    color: var(--text-on-dark);
    border-color: var(--accent);
  }

  .edu-card__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .edu-card__meta {
    font-size: var(--text-xs);
    color: var(--text-muted-on-paper);
  }

  .edu-card__body {
    padding: 0 var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .edu-card__body p {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted-on-paper);
  }

  .edu-card__body strong {
    color: var(--text-on-paper);
    font-weight: 600;
  }
</style>
