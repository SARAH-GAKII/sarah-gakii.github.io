---
interface ExplorerItem {
  id: string;
  title: string;
  meta: string;
}

interface Props {
  items: ExplorerItem[];
  variant?: 'history' | 'community';
}

const { items, variant } = Astro.props;
---

<div
  class:list={['explorer', variant && `explorer--${variant}`]}
  data-explorer
  style={`--explorer-columns:${items.length}`}
>
  <div class="explorer__selector" data-explorer-selector role="group" aria-label="Categories">
    {items.map((item) => (
      <button
        type="button"
        class="explorer__card"
        data-explorer-card
        data-target={item.id}
        id={`card-${item.id}`}
        aria-pressed="false"
        aria-controls={`panel-${item.id}`}
      >
        <span class="explorer__card-title">{item.title}</span>
        <span class="explorer__card-meta">{item.meta}</span>
      </button>
    ))}
  </div>

  <div class="explorer__panels" data-explorer-panels>
    <button type="button" class="explorer__reset" data-explorer-reset>
      Back to overview
    </button>

    {items.map((item) => (
      <div
        class="explorer__panel"
        id={`panel-${item.id}`}
        data-explorer-panel={item.id}
        role="region"
        aria-labelledby={`panel-${item.id}-heading`}
        hidden
      >
        <h3 id={`panel-${item.id}-heading`} class="explorer__panel-heading">{item.title}</h3>
        <slot name={item.id} />
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-explorer-card]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-explorer-panel]'));
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-explorer-reset]');

    const select = (id: string) => {
      root.classList.add('is-selected');
      cards.forEach((card) => {
        const active = card.dataset.target === id;
        card.setAttribute('aria-pressed', String(active));
        card.classList.toggle('is-active', active);
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.explorerPanel !== id;
      });
    };

    const reset = () => {
      root.classList.remove('is-selected');
      cards.forEach((card) => {
        card.setAttribute('aria-pressed', 'false');
        card.classList.remove('is-active');
      });
      panels.forEach((panel) => {
        panel.hidden = true;
      });
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (card.classList.contains('is-active')) {
          reset();
          card.focus();
        } else {
          select(card.dataset.target ?? '');
        }
      });
    });

    resetBtn?.addEventListener('click', () => {
      reset();
      cards[0]?.focus();
    });
  });
</script>

<style>
  .explorer {
    display: grid;
    grid-template-columns: repeat(var(--explorer-columns, 3), minmax(0, 1fr));
    gap: var(--space-5);
    align-items: stretch;
  }

  .explorer__selector {
    display: contents;
  }

  .explorer__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-5);
    padding-right: var(--space-10);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-align: left;
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
  }

  .explorer__card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .explorer__card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .explorer__card.is-active {
    border-color: var(--accent);
    background: var(--surface-muted);
  }

  /* "+" expand indicator, same visual language as Academic Background's
     EducationCard — reflects the card's existing is-active state, which
     the script above already tracks; this is a purely visual addition,
     not a new interaction. */
  .explorer__card::after {
    content: '+';
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--accent);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .explorer__card.is-active::after {
    content: '\2212';
    background: var(--accent);
    color: var(--text-on-dark);
    border-color: var(--accent);
  }

  .explorer__card-title {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .explorer__card-meta {
    font-size: var(--text-xs);
    color: var(--text-muted-on-paper);
  }

  /* History variant: a thin left accent rule as an understated
     chronological marker, on a faint tonal gradient surface. */
  .explorer--history .explorer__card {
    border-left: 3px solid var(--accent-primary);
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-muted) 100%);
  }

  .explorer--history .explorer__card.is-active {
    background: linear-gradient(135deg, var(--surface-muted) 0%, var(--surface) 100%);
  }

  /* Community variant: softer corners and a lavender-tinted surface for a
     slightly more open, editorial feel. */
  .explorer--community .explorer__card {
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--surface) 0%, var(--surface-lavender-tint) 100%);
  }

  .explorer--community .explorer__card.is-active {
    background: linear-gradient(160deg, var(--surface-lavender-tint) 0%, var(--surface) 100%);
  }

  .explorer__panels {
    display: none;
  }

  .explorer__reset {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
  }

  .explorer__reset:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .explorer__reset:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .explorer__panel-heading {
    font-size: var(--text-lg);
    margin-bottom: var(--space-5);
  }

  /* Selected state: sticky left selector + right detail panel */
  .explorer.is-selected {
    grid-template-columns: minmax(240px, 30%) 1fr;
    align-items: start;
  }

  .explorer.is-selected .explorer__selector {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: sticky;
    top: calc(5rem + var(--space-4));
    align-self: start;
  }

  .explorer.is-selected .explorer__panels {
    display: block;
    min-width: 0;
  }

  @media (max-width: 767px) {
    .explorer,
    .explorer.is-selected {
      grid-template-columns: 1fr;
    }

    .explorer.is-selected .explorer__selector {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .explorer.is-selected .explorer__card {
      flex: 1 1 auto;
      min-width: 0;
    }
  }
</style>
