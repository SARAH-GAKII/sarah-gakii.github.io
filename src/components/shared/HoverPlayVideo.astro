---
// Hover/focus/tap-to-play behavior for Work-page project cards that
// contain a video which should stay paused until the visitor interacts
// with it. Research-page cards used to share this component too, but
// their videos now use viewport-driven autoplay instead (see the script
// in src/pages/research/index.astro) — hover-to-play and viewport-driven
// playback would otherwise fight over the same <video> element, so this
// is scoped to .project-card only.
---

<script>
  // Videos on these cards don't autoplay. On hover-capable pointers (and
  // when motion isn't reduced) they play on hover/focus of the whole card
  // and pause, holding the current frame, on mouseleave/blur. On touch
  // devices, and whenever prefers-reduced-motion is set, playback is never
  // triggered passively — a tap/click anywhere on the card explicitly
  // toggles play/pause instead (and is kept from also following the
  // card's link, since the whole card is an <a>).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touchPrimary = window.matchMedia('(hover: none)').matches;
  const tapToggle = touchPrimary || reduceMotion;

  document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
    const video = card.querySelector('video');
    if (!video) return;

    const play = () => {
      video.play().catch(() => {});
    };
    const pause = () => {
      video.pause();
    };

    if (tapToggle) {
      card.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (video.paused) play();
        else pause();
      });
    } else {
      card.addEventListener('mouseenter', play);
      card.addEventListener('mouseleave', pause);
      card.addEventListener('focus', play);
      card.addEventListener('blur', pause);
    }
  });
</script>
