---
// Shared hover/focus/tap-to-play behavior for any project or research card
// that contains a video which should stay paused until the visitor
// interacts with it. Include this once per page (Work, Research) rather
// than duplicating the interaction logic — it targets both card types by
// class name and safely no-ops for cards that don't contain a video.
---

<script>
  // Videos on these cards don't autoplay. On hover-capable pointers (and
  // when motion isn't reduced) they play on hover/focus of the whole card
  // and pause, holding the current frame, on mouseleave/blur. On touch
  // devices, and whenever prefers-reduced-motion is set, playback is never
  // triggered passively — a tap/click anywhere on the card explicitly
  // toggles play/pause instead (and is kept from also following the
  // card's link, since the whole card is an <a>).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touchPrimary = window.matchMedia('(hover: none)').matches;
  const tapToggle = touchPrimary || reduceMotion;

  document.querySelectorAll<HTMLElement>('.research-card, .project-card').forEach((card) => {
    const video = card.querySelector('video');
    if (!video) return;

    const play = () => {
      video.play().catch(() => {});
    };
    const pause = () => {
      video.pause();
    };

    if (tapToggle) {
      card.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (video.paused) play();
        else pause();
      });
    } else {
      card.addEventListener('mouseenter', play);
      card.addEventListener('mouseleave', pause);
      card.addEventListener('focus', play);
      card.addEventListener('blur', pause);
    }
  });
</script>
