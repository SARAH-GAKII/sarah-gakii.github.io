---
// Six-capability mosaic. Each tile carries its own capability-specific analytical graphic
// (not a shared background layer), faintly visible by default and clarifying on hover/focus —
// pure CSS, no JavaScript required. The two largest tiles use a split/stacked composition so
// their size is justified by content, not just used to build a silhouette.
interface Capability {
  index: string;
  title: string;
  description: string;
}

interface Props {
  capabilities: Capability[];
}

const { capabilities } = Astro.props;
---

<div class="cap-mosaic">
  {capabilities.map((capability) => (
    <article
      class:list={[
        'cap-mosaic__cell',
        `cap-mosaic__cell--c${capability.index}`,
        capability.index === '01' && 'cap-mosaic__cell--dark',
        capability.index === '02' && 'cap-mosaic__cell--tinted',
      ]}
      tabindex="0"
    >
      {capability.index === '01' && (
        <div class="cap-mosaic__split">
          <div class="cap-mosaic__text">
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </div>
          <svg class="cap-mosaic__graphic cap-mosaic__graphic--side" aria-hidden="true" viewBox="0 0 200 260" preserveAspectRatio="xMidYMid meet">
            <g fill="none" stroke="currentColor" stroke-width="1.1" opacity="0.6">
              <ellipse cx="100" cy="130" rx="90" ry="110" />
              <ellipse cx="100" cy="130" rx="65" ry="80" />
              <ellipse cx="100" cy="130" rx="40" ry="50" />
            </g>
            <path d="M22,236 Q46,190 70,168 Q90,150 105,138" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 5" opacity="0.75" />
            <circle cx="46" cy="196" r="2.4" fill="currentColor" opacity="0.5" />
            <circle cx="150" cy="70" r="2.4" fill="currentColor" opacity="0.5" />
            <circle cx="160" cy="190" r="2.4" fill="currentColor" opacity="0.5" />
            <circle class="cap-mosaic__final-node" cx="105" cy="138" r="5" />
          </svg>
        </div>
      )}

      {capability.index === '02' && (
        <div class="cap-mosaic__stack">
          <div class="cap-mosaic__text">
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </div>
          <svg class="cap-mosaic__graphic cap-mosaic__graphic--lower" aria-hidden="true" viewBox="0 0 260 110" preserveAspectRatio="xMidYMid slice">
            <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.5">
              <line x1="35" y1="25" x2="130" y2="12" /><line x1="35" y1="55" x2="130" y2="12" />
              <line x1="35" y1="55" x2="130" y2="55" /><line x1="35" y1="85" x2="130" y2="55" />
              <line x1="130" y1="12" x2="220" y2="35" /><line x1="130" y1="55" x2="220" y2="35" />
              <line x1="130" y1="55" x2="220" y2="80" />
            </g>
            <g fill="currentColor" opacity="0.75">
              <circle cx="35" cy="25" r="3.2" /><circle cx="35" cy="55" r="3.2" /><circle cx="35" cy="85" r="3.2" />
              <circle cx="130" cy="12" r="3.2" /><circle cx="130" cy="55" r="3.2" />
              <circle cx="220" cy="35" r="3.2" /><circle cx="220" cy="80" r="3.2" />
            </g>
          </svg>
        </div>
      )}

      {capability.index !== '01' && capability.index !== '02' && (
        <Fragment>
          {capability.index === '03' && (
            <svg class="cap-mosaic__graphic cap-mosaic__graphic--watermark" aria-hidden="true" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice">
              <g stroke="currentColor" stroke-width="1" opacity="0.5" fill="none">
                <line x1="40" y1="130" x2="260" y2="130" />
                <line x1="40" y1="130" x2="40" y2="30" />
              </g>
              <g fill="currentColor" opacity="0.55">
                <rect x="65" y="90" width="16" height="40" />
                <rect x="95" y="70" width="16" height="60" />
                <rect x="125" y="105" width="16" height="25" />
              </g>
              <g fill="currentColor" opacity="0.7">
                <circle cx="175" cy="80" r="3" /><circle cx="200" cy="100" r="3" />
                <circle cx="225" cy="65" r="3" /><circle cx="245" cy="88" r="3" />
              </g>
            </svg>
          )}

          {capability.index === '04' && (
            <svg class="cap-mosaic__graphic cap-mosaic__graphic--watermark" aria-hidden="true" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice">
              <g stroke="currentColor" stroke-width="0.8" opacity="0.45">
                {Array.from({ length: 7 }).map((_, i) => (
                  <line x1={40 + i * 30} y1="25" x2={40 + i * 30} y2="135" />
                ))}
                {Array.from({ length: 5 }).map((_, i) => (
                  <line x1="40" y1={25 + i * 27} x2="220" y2={25 + i * 27} />
                ))}
              </g>
              <path d="M40,115 Q130,55 220,80" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.65" />
            </svg>
          )}

          {capability.index === '05' && (
            <svg class="cap-mosaic__graphic cap-mosaic__graphic--watermark" aria-hidden="true" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice">
              <path d="M150,95 Q195,80 240,35 L240,80 Q195,115 150,110 Z" fill="currentColor" opacity="0.16" stroke="none" />
              <path d="M55,125 Q100,75 150,95" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.65" />
              <path d="M150,95 Q195,100 240,60" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3 4" opacity="0.7" />
              <circle cx="150" cy="95" r="3.5" fill="currentColor" opacity="0.8" />
            </svg>
          )}

          {capability.index === '06' && (
            <svg class="cap-mosaic__graphic cap-mosaic__graphic--watermark" aria-hidden="true" viewBox="0 0 300 160" preserveAspectRatio="xMidYMid slice">
              <g stroke="currentColor" stroke-width="0.8" opacity="0.4">
                <line x1="60" y1="30" x2="60" y2="130" /><line x1="120" y1="30" x2="120" y2="130" />
                <line x1="180" y1="30" x2="180" y2="130" /><line x1="240" y1="30" x2="240" y2="130" />
                <line x1="60" y1="45" x2="240" y2="45" /><line x1="60" y1="85" x2="240" y2="85" />
                <line x1="60" y1="120" x2="240" y2="120" />
              </g>
              <g fill="currentColor" opacity="0.7">
                <circle cx="90" cy="65" r="3.2" /><circle cx="150" cy="100" r="3.2" />
                <circle cx="180" cy="60" r="3.2" /><circle cx="220" cy="95" r="3.2" />
              </g>
              <g stroke="currentColor" stroke-width="1" opacity="0.5">
                <line x1="90" y1="65" x2="150" y2="100" />
                <line x1="150" y1="100" x2="180" y2="60" />
                <line x1="180" y1="60" x2="220" y2="95" />
              </g>
            </svg>
          )}

          <div class="cap-mosaic__text">
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </div>
        </Fragment>
      )}
    </article>
  ))}
</div>

<style>
  .cap-mosaic {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  .cap-mosaic__cell {
    position: relative;
    overflow: hidden;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cap-mosaic__cell:hover,
  .cap-mosaic__cell:focus-visible {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-sm);
  }

  .cap-mosaic__cell:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .cap-mosaic__cell--dark {
    background: var(--surface-indigo-deep);
    border-color: var(--surface-indigo-deep);
  }

  .cap-mosaic__cell--dark:hover,
  .cap-mosaic__cell--dark:focus-visible {
    border-color: var(--accent-primary-on-dark);
  }

  .cap-mosaic__cell--tinted {
    background: var(--surface-blue-gray);
  }

  .cap-mosaic__text h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .cap-mosaic__text p {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted-on-paper);
  }

  .cap-mosaic__cell--dark .cap-mosaic__text h3 {
    color: var(--text-on-dark);
  }

  .cap-mosaic__cell--dark .cap-mosaic__text p {
    color: var(--text-muted-on-dark);
  }

  .cap-mosaic__cell--c01 .cap-mosaic__text h3,
  .cap-mosaic__cell--c02 .cap-mosaic__text h3 {
    font-size: var(--text-lg);
  }

  /* Wide feature tile: text and graphic side by side */
  .cap-mosaic__split {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    height: 100%;
  }

  .cap-mosaic__split .cap-mosaic__text {
    max-width: 26rem;
  }

  .cap-mosaic__graphic--side {
    width: 100%;
    max-width: 11rem;
    align-self: flex-end;
    color: var(--accent-primary-on-dark);
    opacity: 0.5;
    transition: opacity var(--transition-base);
  }

  .cap-mosaic__cell--c01:hover .cap-mosaic__graphic--side,
  .cap-mosaic__cell--c01:focus-visible .cap-mosaic__graphic--side {
    opacity: 0.85;
  }

  .cap-mosaic__final-node {
    fill: var(--accent-on-dark);
  }

  /* Tall/medium tile: text on top, graphic filling the lower area */
  .cap-mosaic__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  .cap-mosaic__graphic--lower {
    flex: 1;
    width: 100%;
    min-height: 5rem;
    color: var(--accent-primary);
    opacity: 0.35;
    transition: opacity var(--transition-base);
  }

  .cap-mosaic__cell--c02:hover .cap-mosaic__graphic--lower,
  .cap-mosaic__cell--c02:focus-visible .cap-mosaic__graphic--lower {
    opacity: 0.65;
  }

  /* Compact/medium tiles: faint full-tile watermark behind the text */
  .cap-mosaic__graphic--watermark {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--accent-primary);
    opacity: 0.14;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .cap-mosaic__cell:hover .cap-mosaic__graphic--watermark,
  .cap-mosaic__cell:focus-visible .cap-mosaic__graphic--watermark {
    opacity: 0.34;
  }

  .cap-mosaic__cell:not(.cap-mosaic__cell--c01):not(.cap-mosaic__cell--c02) .cap-mosaic__text {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 640px) {
    .cap-mosaic {
      grid-template-columns: repeat(2, 1fr);
    }

    .cap-mosaic__cell--c01,
    .cap-mosaic__cell--c02 {
      grid-column: 1 / 3;
    }

    .cap-mosaic__split {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .cap-mosaic__graphic--side {
      max-width: 9rem;
      flex-shrink: 0;
    }
  }

  @media (min-width: 900px) {
    .cap-mosaic {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: minmax(13rem, auto) minmax(8.5rem, auto);
      gap: var(--space-5);
    }

    .cap-mosaic__cell--c01 {
      grid-column: 1 / 5;
      grid-row: 1;
    }

    .cap-mosaic__cell--c02 {
      grid-column: 5 / 7;
      grid-row: 1;
    }

    .cap-mosaic__cell--c04 {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .cap-mosaic__cell--c03 {
      grid-column: 3 / 5;
      grid-row: 2;
    }

    .cap-mosaic__cell--c05 {
      grid-column: 5 / 6;
      grid-row: 2;
    }

    .cap-mosaic__cell--c06 {
      grid-column: 6 / 7;
      grid-row: 2;
    }

    .cap-mosaic__split {
      height: 100%;
    }

    .cap-mosaic__graphic--side {
      max-width: 12rem;
    }
  }
</style>
