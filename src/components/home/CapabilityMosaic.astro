---
// Six-capability toolkit. Every cell shares one structural treatment — no
// featured/dark/tinted variants, no illustration — so all six read as
// equally important. Visual identity comes from typography, a restrained
// per-card gradient (built from the site's existing pale tokens), and a
// quiet EducationCard-style top accent rule — not from a "+" expansion or
// any other interactive affordance.
interface Capability {
  index: string;
  title: string;
  description: string;
}

interface Props {
  capabilities: Capability[];
}

const { capabilities } = Astro.props;
---

<div class="cap-mosaic">
  {capabilities.map((capability) => (
    <article class="cap-mosaic__cell" tabindex="0">
      <div class="cap-mosaic__text">
        <h3>{capability.title}</h3>
        <p>{capability.description}</p>
      </div>
    </article>
  ))}
</div>

<script>
  // Staggering lives entirely in CSS (transition-delay per nth-child) —
  // this script's only job is: (a) opt in to the animated state, but
  // never for reduced-motion users, so the cards' default, pre-JS markup
  // is always fully visible; and (b) reveal once, the first time a
  // meaningful portion of the toolkit row scrolls into view.
  //
  // The double rAF before wiring anything up matters: if the row happens
  // to already be within (or very near) the viewport at page load — e.g.
  // on a tall monitor — IntersectionObserver's first callback can fire
  // before the browser has ever painted the pre-entrance (opacity: 0)
  // state. Without a committed "before" frame there's nothing to visibly
  // transition from, so the cards just appear already in place and the
  // animation looks like it "isn't working." Waiting two frames guarantees
  // the hidden state is painted at least once before the observer can act.
  const mosaic = document.querySelector<HTMLElement>('.cap-mosaic');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mosaic && !prefersReducedMotion && 'IntersectionObserver' in window) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        mosaic.classList.add('js-animate');

        const cells = mosaic.querySelectorAll<HTMLElement>('.cap-mosaic__cell');

        const observer = new IntersectionObserver(
          (entries) => {
            const [entry] = entries;
            if (entry.isIntersecting) {
              cells.forEach((cell) => cell.classList.add('is-visible'));
              observer.disconnect();
            }
          },
          // Require the row to be genuinely, meaningfully in view — not
          // merely touching the bottom edge of the viewport on load.
          { threshold: 0.25, rootMargin: '0px 0px -10% 0px' }
        );

        observer.observe(mosaic);
      });
    });
  }
</script>

<style>
  .cap-mosaic {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  .cap-mosaic__cell {
    position: relative;
    min-height: 7rem;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent-primary);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .cap-mosaic__cell:hover,
  .cap-mosaic__cell:focus-visible {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .cap-mosaic__cell:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Six restrained gradients built from the site's existing pale surface
     tokens (paper / surface / blue-tint / lavender-tint / muted), just
     re-angled and recombined per card — one family, quiet variation. */
  .cap-mosaic__cell:nth-child(1) { background: linear-gradient(135deg, var(--surface) 0%, var(--surface-blue-tint) 100%); }
  .cap-mosaic__cell:nth-child(2) { background: linear-gradient(135deg, var(--surface) 0%, var(--surface-lavender-tint) 100%); }
  .cap-mosaic__cell:nth-child(3) { background: linear-gradient(135deg, var(--paper) 0%, var(--surface-muted) 100%); }
  .cap-mosaic__cell:nth-child(4) { background: linear-gradient(315deg, var(--surface) 0%, var(--surface-lavender-tint) 100%); }
  .cap-mosaic__cell:nth-child(5) { background: linear-gradient(315deg, var(--surface) 0%, var(--surface-blue-tint) 100%); }
  .cap-mosaic__cell:nth-child(6) { background: linear-gradient(135deg, var(--surface) 0%, var(--surface-muted) 100%); }

  .cap-mosaic__text h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .cap-mosaic__text p {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted-on-paper);
  }

  /* Scroll-triggered entrance: cards assemble from the left, once, then
     stay static. Scoped under .js-animate so the un-enhanced/no-JS state
     is simply the cards' normal, fully visible layout above. */
  .cap-mosaic.js-animate .cap-mosaic__cell {
    opacity: 0;
    transform: translateX(-70px);
    transition: opacity 900ms cubic-bezier(0.4, 0, 0.2, 1), transform 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cap-mosaic.js-animate .cap-mosaic__cell.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .cap-mosaic.js-animate .cap-mosaic__cell:nth-child(1) { transition-delay: 0ms; }
  .cap-mosaic.js-animate .cap-mosaic__cell:nth-child(2) { transition-delay: 150ms; }
  .cap-mosaic.js-animate .cap-mosaic__cell:nth-child(3) { transition-delay: 300ms; }
  .cap-mosaic.js-animate .cap-mosaic__cell:nth-child(4) { transition-delay: 450ms; }
  .cap-mosaic.js-animate .cap-mosaic__cell:nth-child(5) { transition-delay: 600ms; }
  .cap-mosaic.js-animate .cap-mosaic__cell:nth-child(6) { transition-delay: 750ms; }

  @media (max-width: 639px) {
    .cap-mosaic.js-animate .cap-mosaic__cell {
      transform: translateX(-40px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cap-mosaic.js-animate .cap-mosaic__cell {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .cap-mosaic {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .cap-mosaic {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .cap-mosaic {
      grid-template-columns: repeat(6, 1fr);
      gap: var(--space-4);
    }
  }
</style>
