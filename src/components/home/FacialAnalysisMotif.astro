---
// Homepage visualization for Facial Emotion Recognition: an abstract facial-
// landmark diagram (outline, eyebrows, eyes, nose, mouth, a sparse geometry
// mesh connecting them, and a couple of measurement ticks) rather than the
// confusion matrix used inside the case study itself. Reads as "a model
// examining facial geometry," not a decorative face. Single-color (inherits
// currentColor, i.e. --accent-primary from .evidence-card__visual) with
// opacity carrying all hierarchy, matching the choropleth/network motifs
// beside it. The two classed elements (.fam-brow-l/.fam-brow-r and
// .fam-mouth-center) are nudged a couple of px by the parent page's
// .evidence-card:hover / :focus-visible rules — this component only
// supplies the markup, not the interaction.
---

<svg class="fam" viewBox="0 0 200 125" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <ellipse class="fam-outline" cx="105" cy="64" rx="40" ry="47" fill="none" />

  <g class="fam-mesh" fill="none">
    <line x1="90" y1="46" x2="90" y2="50" />
    <line x1="120" y1="46" x2="120" y2="50" />
    <line x1="90" y1="54" x2="103" y2="78" />
    <line x1="120" y1="54" x2="103" y2="78" />
    <line x1="103" y1="78" x2="88" y2="95" />
    <line x1="103" y1="78" x2="122" y2="95" />
    <line x1="90" y1="52" x2="120" y2="52" />
  </g>

  <path class="fam-brow fam-brow-l" d="M83,44 Q90,39 98,42" fill="none" />
  <path class="fam-brow fam-brow-r" d="M112,42 Q120,39 127,44" fill="none" />

  <ellipse class="fam-eye-outline" cx="90" cy="52" rx="7" ry="4" fill="none" />
  <ellipse class="fam-eye-outline" cx="120" cy="52" rx="7" ry="4" fill="none" />
  <circle class="fam-landmark" cx="90" cy="52" r="2" />
  <circle class="fam-landmark" cx="120" cy="52" r="2" />

  <line class="fam-nose" x1="105" y1="56" x2="103" y2="78" />
  <circle class="fam-landmark" cx="103" cy="78" r="1.6" />

  <path class="fam-mouth-path" d="M88,95 Q105,102 122,95" fill="none" />
  <circle class="fam-landmark" cx="88" cy="95" r="1.6" />
  <circle class="fam-landmark fam-mouth-center" cx="105" cy="100" r="2.2" />
  <circle class="fam-landmark" cx="122" cy="95" r="1.6" />

  <g class="fam-ticks">
    <line x1="61" y1="64" x2="68" y2="64" />
    <line x1="64.5" y1="60.5" x2="64.5" y2="67.5" />
    <line x1="142" y1="64" x2="149" y2="64" />
    <line x1="145.5" y1="60.5" x2="145.5" y2="67.5" />
  </g>
</svg>

<style>
  .fam {
    width: 100%;
    height: 100%;
    color: currentColor;
  }

  .fam-outline {
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.28;
  }

  .fam-mesh line {
    stroke: currentColor;
    stroke-width: 0.7;
    opacity: 0.15;
  }

  .fam-brow {
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    opacity: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 380ms ease;
  }

  .fam-eye-outline {
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.25;
  }

  .fam-nose {
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.2;
  }

  .fam-mouth-path {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.35;
  }

  .fam-landmark {
    fill: currentColor;
    opacity: 0.55;
  }

  .fam-mouth-center {
    opacity: 0.9;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 380ms ease;
  }

  .fam-ticks line {
    stroke: currentColor;
    stroke-width: 0.7;
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .fam-brow,
    .fam-mouth-center {
      transition: none;
    }
  }
</style>
