---
// Compact analytical module: a circular illustrative image, a short label, and a
// curiosity-driven question. Used on the homepage's "Analytical thinking in practice" section.
// The image is expected to already carry its own circular visual treatment — this
// component only sizes and aligns it, it does not add a second circular frame.
interface Props {
  image: string;
  label: string;
  question: string;
}

const { image, label, question } = Astro.props;
---

<article class="analytical-module">
  <img class="analytical-module__icon" src={image} alt="" loading="lazy" decoding="async" />
  <div class="analytical-module__body">
    <span class="analytical-module__label">{label}</span>
    <p class="analytical-module__question">{question}</p>
  </div>
</article>

<style>
  .analytical-module {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .analytical-module__icon {
    width: 4.5rem;
    aspect-ratio: 1 / 1;
    max-width: 100%;
    flex-shrink: 0;
    object-fit: contain;
  }

  /* Size steps match the section's own grid breakpoints (see
     .analytical-practice__grid in index.astro: 2 columns at 640px, 4
     columns at 900px) so the icon grows in step with the layout it's
     already responding to, reaching 200px at the desktop breakpoint.
     aspect-ratio (not a fixed height) keeps the square proportions of the
     source images exact at every step, and max-width: 100% is a pure
     safety net — it only engages if a grid column is ever narrower than
     the target size, shrinking the image to fit rather than overflowing
     its column; at normal desktop widths it has no visible effect. */
  @media (min-width: 640px) {
    .analytical-module__icon {
      width: 8rem;
    }
  }

  @media (min-width: 900px) {
    .analytical-module__icon {
      width: 12.5rem;
    }
  }

  .analytical-module__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .analytical-module__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .analytical-module__question {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--text-on-paper);
    max-width: 22rem;
  }
</style>
