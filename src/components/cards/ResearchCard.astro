---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  thumbnail?: string;
  compact?: boolean;
}

const { slug, title, summary, tags, thumbnail, compact = false } = Astro.props;
const hasMediaSlot = Astro.slots.has('media');
const hasMedia = !compact && (hasMediaSlot || thumbnail);
---

<a class="research-card" class:list={[{ 'research-card--compact': compact }]} href={`/research/${slug}/`}>
  {hasMedia && (
    <div class="research-card__media">
      {hasMediaSlot ? <slot name="media" /> : <img src={thumbnail} alt="" loading="lazy" />}
    </div>
  )}

  <div class="research-card__body">
    <h3>{title}</h3>
    <p class="research-card__summary text-muted">{summary}</p>
    <p class="research-card__tags">{tags.join(' · ')}</p>
  </div>
</a>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .research-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .research-card__media {
    aspect-ratio: 16 / 10;
    background: var(--surface-muted);
    overflow: hidden;
  }

  .research-card__media img,
  .research-card__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .research-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex: 1;
  }

  .research-card__body h3 {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .research-card__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .research-card__tags {
    margin-top: auto;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-muted-on-paper);
  }
</style>
