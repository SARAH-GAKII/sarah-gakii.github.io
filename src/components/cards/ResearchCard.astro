---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  thumbnail?: string;
  compact?: boolean;
  orientation?: 'horizontal';
  mediaFit?: 'contain';
}

const { slug, title, summary, tags, thumbnail, compact = false, orientation, mediaFit } = Astro.props;
const hasMediaSlot = Astro.slots.has('media');
const hasMedia = !compact && (hasMediaSlot || thumbnail);
---

<a
  class="research-card"
  class:list={[
    { 'research-card--compact': compact },
    orientation === 'horizontal' && 'research-card--horizontal',
  ]}
  href={`/research/${slug}/`}
>
  {hasMedia && (
    <div class:list={['research-card__media', mediaFit === 'contain' && 'research-card__media--contain']}>
      {hasMediaSlot ? <slot name="media" /> : <img src={thumbnail} alt="" loading="lazy" />}
    </div>
  )}

  <div class="research-card__body">
    <h3>{title}</h3>
    <p class="research-card__summary text-muted">{summary}</p>
    <p class="research-card__tags">{tags.join(' · ')}</p>
  </div>
</a>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .research-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .research-card__media {
    aspect-ratio: 16 / 10;
    background: var(--surface-muted);
    overflow: hidden;
  }

  /* The vaccine/Newton-FD/Academic-Workshops videos are authored in the
     research index page and passed in through the `media` slot, so they
     carry that page's own Astro scope attribute, not this component's —
     a plain scoped selector can never match them. :global() opts these
     rules out of scoping so they reach the actual <video> node instead. */
  .research-card__media :global(img),
  .research-card__media :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .research-card__media--contain :global(img),
  .research-card__media--contain :global(video) {
    object-fit: contain;
  }

  .research-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex: 1;
  }

  .research-card__body h3 {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .research-card__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .research-card__tags {
    margin-top: auto;
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-muted-on-paper);
  }

  /* Horizontal variant: spans two of the grid's own tracks (not an
     arbitrary width) and switches to a two-column grid internally —
     video left, content right.

     The media pane is a square (aspect-ratio: 1/1). Its width is already
     one grid column (half of the two-column span), so a square ratio
     makes its height match that same width — "approximately one
     standard card's width" — without hardcoding a rem value or
     calc()-ing against a sibling track. That gives the pane a real,
     definite size that doesn't depend on the video's own intrinsic
     dimensions or on flex/grid stretch, so width:100%/height:100% with
     object-fit:contain (the default --contain behavior above) can safely
     letterbox the video inside it — centered by object-position's own
     default, on the pane's existing neutral background — with no
     cropping, no stretching, and none of the earlier circular-sizing
     bug. Below the breakpoint it falls back to the default stacked
     layout above. */
  @media (min-width: 640px) {
    .research-card--horizontal {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .research-card--horizontal .research-card__media {
      aspect-ratio: 1 / 1;
    }
  }
</style>
