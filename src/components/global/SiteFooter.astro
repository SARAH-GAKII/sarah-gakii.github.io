---
import { contactLinks } from '../../data/about';

const year = new Date().getFullYear();

const platformLinks = [
  { label: 'Work', href: '/work/' },
  { label: 'Research', href: '/research/' },
  { label: 'About', href: '/about/' },
];

const contactChannels = [
  {
    label: 'Email',
    href: `mailto:${contactLinks.email}`,
    icon: 'email',
  },
  {
    label: 'LinkedIn',
    href: contactLinks.linkedin,
    icon: 'linkedin',
    external: true,
  },
  {
    label: 'GitHub',
    href: contactLinks.github,
    icon: 'github',
    external: true,
  },
];
---

<footer class="site-footer section--dark" id="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__intro">
      <h2 id="footer-connect-heading">Let&rsquo;s connect</h2>
      <p class="text-muted site-footer__mission">
        Open to roles, collaborations, and questions about the work shown here.
      </p>
      <ul class="site-footer__channels" aria-labelledby="footer-connect-heading">
        {contactChannels.map((channel) => (
          <li>
            <a
              class="site-footer__channel"
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener' : undefined}
              aria-label={`${channel.label} — Sarah G. Randol`}
              title={channel.label}
            >
              <span aria-hidden="true">
                {channel.icon === 'email' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m4 7 8 6 8-6" />
                  </svg>
                )}
                {channel.icon === 'linkedin' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6.94 8.5H3.56V20.5H6.94V8.5ZM5.25 3.5C4.15 3.5 3.3 4.36 3.3 5.42C3.3 6.47 4.15 7.34 5.25 7.34C6.34 7.34 7.19 6.47 7.19 5.42C7.19 4.36 6.34 3.5 5.25 3.5ZM20.5 20.5V13.86C20.5 10.61 18.75 9.1 16.42 9.1C14.55 9.1 13.71 10.13 13.24 10.85V9.4H9.86C9.9 10.24 9.86 20.5 9.86 20.5H13.24V14.4C13.24 14.07 13.26 13.75 13.36 13.52C13.62 12.87 14.22 12.2 15.22 12.2C16.54 12.2 17.12 13.2 17.12 14.66V20.5H20.5Z" />
                  </svg>
                )}
                {channel.icon === 'github' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.58 2 12.19C2 16.68 4.87 20.47 8.84 21.8C9.34 21.9 9.5 21.58 9.5 21.31C9.5 21.07 9.5 20.31 9.49 19.33C6.73 19.94 6.14 17.96 6.14 17.96C5.68 16.77 5.03 16.45 5.03 16.45C4.12 15.81 5.1 15.83 5.1 15.83C6.1 15.9 6.63 16.87 6.63 16.87C7.5 18.38 8.94 17.95 9.51 17.69C9.6 17.04 9.86 16.61 10.14 16.36C7.94 16.11 5.62 15.25 5.62 11.4C5.62 10.29 6.01 9.39 6.65 8.68C6.55 8.42 6.2 7.39 6.75 6.01C6.75 6.01 7.59 5.73 9.48 7.02C10.28 6.79 11.14 6.68 12 6.68C12.86 6.68 13.72 6.79 14.52 7.02C16.41 5.73 17.25 6.01 17.25 6.01C17.8 7.39 17.45 8.42 17.35 8.68C17.99 9.39 18.38 10.29 18.38 11.4C18.38 15.26 16.05 16.11 13.84 16.35C14.2 16.66 14.52 17.27 14.52 18.2C14.52 19.53 14.51 20.97 14.51 21.31C14.51 21.58 14.67 21.91 15.18 21.8C19.14 20.46 22 16.68 22 12.19C22 6.58 17.52 2 12 2Z" />
                  </svg>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="site-footer__column" aria-label="Platform">
      <h3>Platform</h3>
      <ul>
        {platformLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p class="text-muted">&copy; {year} Sarah G. Randol. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-10) var(--space-6);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-on-dark);
  }

  .site-footer__intro h2 {
    font-size: var(--text-xl);
    color: var(--text-on-dark);
  }

  .site-footer__mission {
    margin-top: var(--space-3);
    max-width: 26rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .site-footer__channels {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .site-footer__column h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted-on-dark);
    margin-bottom: var(--space-4);
  }

  .site-footer__column ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__column > ul a:hover {
    color: var(--accent-on-dark);
  }

  .site-footer__channel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--border-on-dark);
    color: var(--text-muted-on-dark);
    transition: border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .site-footer__channel svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .site-footer__channel:hover,
  .site-footer__channel:focus-visible {
    border-color: var(--accent-on-dark);
    color: var(--accent-on-dark);
    transform: translateY(-2px);
  }

  .site-footer__bottom {
    padding-top: var(--space-6);
  }

  .site-footer__bottom p {
    font-size: var(--text-xs);
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }
</style>
