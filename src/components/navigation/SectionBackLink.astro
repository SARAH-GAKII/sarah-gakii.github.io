---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="section-back-link" href={href}>
  {label}
</a>

<style>
  .section-back-link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .section-back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
