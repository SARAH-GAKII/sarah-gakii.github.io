---
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import '../styles/global.css';
import { contactLinks } from '../data/about';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = image ? new URL(image, Astro.site).toString() : undefined;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sarah G. Randol',
  alternateName: 'Sarah Gakii',
  url: Astro.site!.toString(),
  jobTitle: 'Data Scientist and Applied Mathematician',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Ohio',
    addressCountry: 'US',
  },
  sameAs: [contactLinks.linkedin, contactLinks.github],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1KWTK4LBST"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1KWTK4LBST');
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
      is:inline
    />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
