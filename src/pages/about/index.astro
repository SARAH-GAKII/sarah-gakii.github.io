---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import MediaRibbon from '../../components/media/MediaRibbon.astro';
import AxisMotif from '../../components/decorative/AxisMotif.astro';
import EducationCard from '../../components/about/EducationCard.astro';
import MasterDetailExplorer from '../../components/about/MasterDetailExplorer.astro';
import RoleList from '../../components/about/RoleList.astro';
import {
  bio,
  education,
  awards,
  experience,
  teachingPhilosophy,
  mentoringSupport,
  habitatForHumanity,
  campusInvolvementIntro,
  campusInvolvementGroups,
  beyondTheResume,
} from '../../data/about';

const professionalFocus = [
  { index: '01', title: 'Applied AI & Data Science', description: 'Developing data-driven models and analytical workflows that extract meaningful insight from complex datasets.' },
  { index: '02', title: 'Machine Learning & Statistical Analysis', description: 'Applying machine learning and statistical techniques to uncover patterns, support predictions, and inform decisions.' },
  { index: '03', title: 'Mathematical & Computational Modeling', description: 'Designing and analyzing numerical methods, simulations, and mathematical models to study complex systems.' },
  { index: '04', title: 'Data Analytics & Visualization', description: 'Transforming raw data into interpretable insights through exploratory analysis, dashboards, and visual storytelling.' },
  { index: '05', title: 'Scientific Computing & Numerical Methods', description: 'Implementing computational techniques to solve mathematical models and engineering problems.' },
];

const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const historyItems = experience.map((group) => ({
  id: slugify(group.category),
  title: group.category,
  meta: group.meta,
}));

const dataScienceGroup = experience.find((group) => group.category === 'Data Science, AI & Technical')!;
const teachingGroup = experience.find((group) => group.category === 'Teaching & Mentorship')!;
const manufacturingGroup = experience.find((group) => group.category === 'Industrial Operations & Manufacturing')!;

const campusEntryCount = campusInvolvementGroups.reduce((sum, group) => sum + group.entries.length, 0);

const beyondItems = [
  { id: 'habitat', title: habitatForHumanity.title, meta: habitatForHumanity.meta },
  { id: 'campus', title: 'Community & Campus Involvement', meta: `${campusEntryCount} initiatives` },
];
---

<BaseLayout
  title="About — Sarah G. Randol"
  description="Applied mathematician and data scientist working across mathematics, optimization, data science, and AI — background, education, and experience."
>
  <!-- Intro -->
  <section class="section section--tight about-intro">
    <div class="about-intro__motif" aria-hidden="true">
      <AxisMotif />
    </div>
    <div class="container about-intro__grid">
      <div class="about-intro__copy">
        <span class="eyebrow">About</span>
        <h1>{bio.name}</h1>
        {bio.paragraphs.map((paragraph) => (
          <p class="prose-width">{paragraph}</p>
        ))}
      </div>
      <div class="about-intro__portrait">
        <img src={bio.headshot} alt={`Portrait of ${bio.name}`} />
      </div>
    </div>
  </section>

  <!-- Professional Focus -->
  <section class="section section--tight section--dark">
    <div class="container">
      <SectionHeading eyebrow="Professional focus" title="Professional Focus" />
      <ol class="method-path">
        {professionalFocus.map((step) => (
          <li class="method-path__step">
            <span class="method-path__marker" aria-hidden="true">{step.index}</span>
            <div class="method-path__content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Academic Background -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="Education" title="Academic background" />
      <div class="education-grid">
        {education.map((entry) => (
          <EducationCard
            title={entry.title}
            meta={entry.meta}
            description={entry.description}
            courses={entry.courses}
          />
        ))}
      </div>

      <h3 class="recognition-heading">Recognition along the way</h3>
      <div class="recognition-grid">
        {awards.map((award) => (
          <article class="recognition-card">
            <h4>{award.title}</h4>
            <p class="recognition-card__meta text-muted">{award.meta}</p>
            <p>{award.description}</p>
            {award.link && (
              <a href={award.link.href} target="_blank" rel="noopener">{award.link.label}</a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Professional History -->
  <section class="section section--tight section--muted">
    <div class="container">
      <SectionHeading eyebrow="Experience" title="Professional history" />
      <MasterDetailExplorer items={historyItems}>
        <Fragment slot={slugify(dataScienceGroup.category)}>
          <RoleList entries={dataScienceGroup.entries} />
        </Fragment>
        <Fragment slot={slugify(teachingGroup.category)}>
          <RoleList entries={teachingGroup.entries} />
          <div class="teaching-extra">
            <div class="teaching-extra__block">
              <h4>Teaching philosophy</h4>
              <p>{teachingPhilosophy}</p>
              <div class="teaching-extra__badges">
                <img src="/images/about/active-learning-badge.png" alt="Active Learning Certificate Program badge, BGSU" loading="lazy" />
                <img src="/images/about/intro-ai-cloud-certificate.png" alt="Introduction to AI on Cloud certificate" loading="lazy" />
              </div>
            </div>
            <div class="teaching-extra__block">
              <h4>{mentoringSupport.title}</h4>
              <ul>
                {mentoringSupport.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </div>
        </Fragment>
        <Fragment slot={slugify(manufacturingGroup.category)}>
          <RoleList entries={manufacturingGroup.entries} />
        </Fragment>
      </MasterDetailExplorer>
    </div>
  </section>

  <!-- Beyond the Technical Work -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading eyebrow="Community" title="Beyond the technical work" />
      <MasterDetailExplorer items={beyondItems}>
        <Fragment slot="habitat">
          <p class="community-copy">{habitatForHumanity.intro}</p>
          <ul class="community-bullets">
            {habitatForHumanity.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <p class="community-copy">{habitatForHumanity.closing}</p>
          <p class="community-lead">{habitatForHumanity.lead}</p>
        </Fragment>
        <Fragment slot="campus">
          <p class="community-intro">{campusInvolvementIntro}</p>
          {campusInvolvementGroups.map((group) => (
            <div class="community-group">
              <h4>{group.title}</h4>
              <ul class="community-compact-list">
                {group.entries.map((item) => (
                  <li><strong>{item.title} ({item.meta}):</strong> {item.description}</li>
                ))}
              </ul>
            </div>
          ))}
        </Fragment>
      </MasterDetailExplorer>
    </div>
  </section>

  <!-- Ambient media ribbon -->
  <section class="section section--tight ribbon-section">
    <div class="container">
      <span class="eyebrow">Beyond the resume</span>
    </div>
    <MediaRibbon items={beyondTheResume} />
  </section>
</BaseLayout>

<style>
  .about-intro {
    position: relative;
    overflow: hidden;
  }

  .about-intro__motif {
    position: absolute;
    inset: -15% -10% -15% auto;
    width: 55%;
    color: var(--accent-tertiary);
    opacity: 0.4;
    pointer-events: none;
    mask-image: linear-gradient(to left, black 20%, transparent 80%);
  }

  .about-intro__grid {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }

  .about-intro__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-intro__copy h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-1);
  }

  .about-intro__copy p {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-muted-on-paper);
  }

  .about-intro__portrait {
    order: -1;
  }

  .about-intro__portrait img {
    width: 100%;
    max-width: 12rem;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Professional focus */
  .method-path {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .method-path__step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .method-path__marker {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong-on-dark);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--accent-on-dark);
  }

  .method-path__content h3 {
    font-size: var(--text-sm);
    color: var(--text-on-dark);
  }

  .method-path__content p {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  /* Academic background */
  .education-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .recognition-heading {
    margin-top: var(--space-10);
    font-size: var(--text-lg);
  }

  .recognition-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    align-items: stretch;
    margin-top: var(--space-5);
  }

  .recognition-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .recognition-card h4 {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .recognition-card__meta {
    font-size: var(--text-xs);
  }

  .recognition-card p:not(.recognition-card__meta) {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .recognition-card a {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .recognition-card a:hover,
  .recognition-card a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Professional History extras (slotted into MasterDetailExplorer) */
  .teaching-extra {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px dashed var(--border);
  }

  .teaching-extra__block h4 {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted-on-paper);
    margin-bottom: var(--space-2);
  }

  .teaching-extra__block p {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 46rem;
  }

  .teaching-extra__block ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: disc;
    padding-left: var(--space-4);
  }

  .teaching-extra__block li {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .teaching-extra__badges {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .teaching-extra__badges img {
    height: 3.5rem;
    width: auto;
    border-radius: var(--radius-sm);
  }

  /* Beyond the Technical Work content (slotted into MasterDetailExplorer) */
  .community-copy {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 46rem;
  }

  .community-copy + .community-copy {
    margin-top: var(--space-3);
  }

  .community-bullets {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: disc;
    padding-left: var(--space-4);
    margin: var(--space-3) 0;
    max-width: 46rem;
  }

  .community-bullets li {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .community-lead {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .community-intro {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 46rem;
  }

  .community-group {
    margin-top: var(--space-6);
  }

  .community-group:first-of-type {
    margin-top: var(--space-5);
  }

  .community-group h4 {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted-on-paper);
    margin-bottom: var(--space-3);
  }

  .community-compact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: disc;
    padding-left: var(--space-4);
    max-width: 46rem;
  }

  .community-compact-list li {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .community-compact-list strong {
    font-weight: 600;
    color: var(--text-on-paper);
  }

  .ribbon-section {
    padding-block: var(--space-5) var(--space-6);
  }

  .ribbon-section .container {
    margin-bottom: var(--space-4);
  }

  @media (min-width: 720px) {
    .about-intro__grid {
      grid-template-columns: 1fr 12rem;
      align-items: start;
      gap: var(--space-8);
    }

    .about-intro__portrait {
      order: 0;
    }
  }

  @media (min-width: 860px) {
    .method-path {
      flex-direction: row;
      position: relative;
    }

    .method-path::before {
      content: '';
      position: absolute;
      top: 1.25rem;
      left: 6%;
      right: 6%;
      height: 1px;
      background: var(--border-on-dark);
      z-index: 0;
    }

    .method-path__step {
      flex: 1;
      flex-direction: column;
      gap: var(--space-3);
      position: relative;
      z-index: 1;
    }

    .method-path__marker {
      background: var(--ink-950);
    }

    .method-path__content p {
      max-width: 13rem;
    }
  }

  @media (min-width: 640px) {
    .education-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recognition-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .education-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
