---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import OptimizationMotif from '../components/decorative/OptimizationMotif.astro';

const problems = [
  'Which markets, assets, or projects deserve investment when resources and time are limited?',
  'How do you forecast demand, price, or behavior well enough to act on it?',
  'How do you turn a large, messy, or incomplete dataset into a decision-ready model?',
  'How do you know a model is actually right, and how much should it be trusted?',
];

const capabilities = [
  {
    index: '01',
    title: 'Optimization & Decision Systems',
    description:
      'Formulating constraints, objectives, and trade-offs into models that support real decisions under scarcity.',
  },
  {
    index: '02',
    title: 'Applied AI & Machine Learning',
    description:
      'Building and evaluating models — from classification to recommendation — grounded in how the underlying data was generated.',
  },
  {
    index: '03',
    title: 'Analytics & Business Intelligence',
    description:
      'Turning operational and market data into dashboards and metrics that hold up under scrutiny.',
  },
  {
    index: '04',
    title: 'Mathematical & Computational Modeling',
    description:
      "Using differential equations, numerical methods, and simulation to study systems that don't have closed-form answers.",
  },
  {
    index: '05',
    title: 'Forecasting & Planning',
    description:
      'Structuring uncertain futures — markets, demand, behavior — into models that support planning, not just prediction.',
  },
  {
    index: '06',
    title: 'Data Products & Visualization',
    description:
      'Turning models and analysis into interpretable, decision-ready visual tools.',
  },
];

const engagementPaths = [
  {
    audience: 'Hiring managers & recruiters',
    description: 'Evidence of how I structure ambiguous problems and ship analytical work that holds up.',
    ctaLabel: 'Discuss a role',
  },
  {
    audience: 'Business leaders & collaborators',
    description: 'A partner for analytics, optimization, or AI work tied to a real operational decision.',
    ctaLabel: 'Start a conversation',
  },
  {
    audience: 'Technical reviewers',
    description: 'Methodology, assumptions, and validation available on request for any project shown here.',
    ctaLabel: 'Ask about the method',
  },
];

const featuredProjectSlugs = ['facial-emotion-recognition', 'ohio-housing-affordability-analysis', 'ohio-energy-composition-analysis'];
const allProjects = await getCollection('work');
const featuredProjects = featuredProjectSlugs
  .map((slug) => allProjects.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const featuredResearch = (await getCollection('research'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title="Sarah G. Randol — Applied Mathematics, Optimization & AI"
  description="A digital home for advanced analytical thinking: mathematics, optimization, data science, and AI applied to real organizational decisions."
>
  <!-- Hero -->
  <section class="hero section--dark section">
    <div class="hero__motif" aria-hidden="true">
      <OptimizationMotif />
    </div>
    <div class="container hero__grid">
      <h1 class="hero__identity">A digital home for advanced analytical thinking.</h1>
      <p class="hero__headline prose-width">
        Turning complex problems into decisions you can act on.
      </p>
      <p class="hero__subhead text-muted prose-width">
        I build mathematical models, optimization systems, and applied AI tools that help
        organizations structure ambiguity, forecast what's coming, and make better decisions
        with the data they already have.
      </p>
      <div class="hero__actions">
        <Button href="/work/">See the work</Button>
        <Button href="#capabilities" variant="secondary">How I can help</Button>
      </div>
    </div>
  </section>

  <!-- Problems / decisions -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Where this becomes useful"
        title="Problems worth solving carefully"
        description="Complex organizational problems can be made clearer, more structured, and more actionable through rigorous analytical thinking."
      />
      <ul class="problems-list">
        {problems.map((problem, i) => (
          <li class="problems-list__item">
            <span class="problems-list__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p>{problem}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="section section--muted">
    <div class="container">
      <SectionHeading
        eyebrow="Capabilities"
        title="What I help organizations do"
        description="Not a technology list — a set of capabilities applied to real decisions."
      />
      <ol class="capability-list">
        {capabilities.map((capability) => (
          <li class="capability-list__item">
            <span class="capability-list__index" aria-hidden="true">{capability.index}</span>
            <div class="capability-list__body">
              <h3>{capability.title}</h3>
              <p class="text-muted">{capability.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Selected work"
        title="Evidence, not claims"
        description="A sample of completed projects. Every one shown here is real, finished work."
      />
      <div class="work-preview-grid">
        {featuredProjects.map((project, i) => (
          <div class:list={['work-preview-grid__item', { 'work-preview-grid__item--feature': i === 0 }]}>
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              summary={project.data.summary}
              methods={project.data.methods}
              status={project.data.status}
              thumbnail={project.data.thumbnail}
            />
          </div>
        ))}
      </div>
      <div class="section-cta">
        <Button href="/work/" variant="ghost">See all work &rarr;</Button>
      </div>
    </div>
  </section>

  <!-- Research teaser -->
  <section class="section section--muted">
    <div class="container">
      <SectionHeading
        eyebrow="Research"
        title="Mathematical & computational research"
        description="Published and graduate research spanning PDEs, epidemic modeling, and dynamical systems."
      />
      <ul class="research-teaser-list">
        {featuredResearch.map((item) => (
          <li class="research-teaser-list__item">
            <a href={`/research/${item.id}/`} class="research-teaser-list__link">
              <span class="research-teaser-list__heading">
                <h3>{item.data.title}</h3>
                <span class="research-teaser-list__tags">{item.data.tags.join(' · ')}</span>
              </span>
              <p class="text-muted research-teaser-list__summary">{item.data.summary}</p>
              <span class="research-teaser-list__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="section-cta">
        <Button href="/research/" variant="ghost">See all research &rarr;</Button>
      </div>
    </div>
  </section>

  <!-- Engagement paths -->
  <section class="section section--dark">
    <div class="container">
      <SectionHeading
        eyebrow="Get involved"
        title="A few ways to engage"
      />
      <ul class="engagement-list">
        {engagementPaths.map((path) => (
          <li class="engagement-list__item">
            <h3>{path.audience}</h3>
            <p class="text-muted">{path.description}</p>
            <a class="engagement-list__link" href="#site-footer">
              {path.ctaLabel}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing CTA / contact -->
  <section class="section closing-cta">
    <div class="container closing-cta__inner">
      <h2>Have a problem worth structuring carefully?</h2>
      <p class="text-muted prose-width">
        Reach out about a role, a project, or a question about the methodology behind any work shown here.
      </p>
      <div class="hero__actions">
        <Button href="#site-footer">Get in touch</Button>
        <Button href="/about/" variant="secondary">More on how I work</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__motif {
    position: absolute;
    inset: -10% -20% -10% auto;
    width: 78%;
    color: var(--text-on-dark);
    pointer-events: none;
    mask-image: linear-gradient(to left, black 45%, transparent 92%);
  }

  .hero__grid {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 50rem;
  }

  .hero__identity {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    color: var(--text-on-dark);
    max-width: 22ch;
  }

  .hero__headline {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--accent-on-dark);
  }

  .hero__subhead {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  /* Problems list — typographic ledger, no boxes */
  .problems-list {
    display: flex;
    flex-direction: column;
  }

  .problems-list__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .problems-list__item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .problems-list__index {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--accent);
  }

  .problems-list__item p {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    max-width: 40rem;
  }

  /* Capabilities — numbered row index, no cards */
  .capability-list {
    display: flex;
    flex-direction: column;
  }

  .capability-list__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-strong);
  }

  .capability-list__item:last-child {
    border-bottom: 1px solid var(--border-strong);
  }

  .capability-list__index {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--accent);
  }

  .capability-list__body h3 {
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
  }

  .capability-list__body p {
    max-width: 34rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  /* Selected work — asymmetric feature + two supporting */
  .work-preview-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  .work-preview-grid__item {
    height: 100%;
  }

  .section-cta {
    margin-top: var(--space-8);
  }

  /* Research teaser — horizontal editorial list */
  .research-teaser-list {
    display: flex;
    flex-direction: column;
  }

  .research-teaser-list__item {
    border-top: 1px solid var(--border);
  }

  .research-teaser-list__item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .research-teaser-list__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding-block: var(--space-6);
    position: relative;
  }

  .research-teaser-list__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .research-teaser-list__heading h3 {
    font-size: var(--text-md);
  }

  .research-teaser-list__tags {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-muted-on-paper);
  }

  .research-teaser-list__summary {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 40rem;
  }

  .research-teaser-list__arrow {
    display: none;
  }

  .research-teaser-list__link:hover .research-teaser-list__heading h3 {
    color: var(--accent);
  }

  /* Engagement paths — plain list, no borders */
  .engagement-list {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .engagement-list__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .engagement-list__item h3 {
    font-size: var(--text-md);
    color: var(--text-on-dark);
  }

  .engagement-list__item p {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .engagement-list__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-on-dark);
    padding-top: var(--space-2);
  }

  .engagement-list__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .closing-cta__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    text-align: center;
    align-items: center;
  }

  .closing-cta__inner h2 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 640px) {
    .research-teaser-list__link {
      grid-template-columns: 1fr 1.2fr;
      align-items: center;
      gap: var(--space-6);
    }
  }

  @media (min-width: 860px) {
    .capability-list__item {
      grid-template-columns: 4rem 1fr;
    }

    .work-preview-grid {
      grid-template-columns: 1.3fr 1fr;
      grid-template-rows: repeat(2, auto);
    }

    .work-preview-grid__item--feature {
      grid-column: 1;
      grid-row: 1 / 3;
    }
  }
</style>
