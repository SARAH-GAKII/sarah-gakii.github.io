---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import HeroDecisionPath from '../components/home/HeroDecisionPath.astro';
import AnalyticalModule from '../components/home/AnalyticalModule.astro';
import CapabilityMosaic from '../components/home/CapabilityMosaic.astro';
import ResearchPreviewCircle from '../components/home/ResearchPreviewCircle.astro';

const analyticalModules = [
  {
    variant: 'allocation' as const,
    label: 'Investment & allocation',
    question: 'Which markets, assets, or projects deserve investment when resources and time are limited?',
  },
  {
    variant: 'forecasting' as const,
    label: 'Forecasting under uncertainty',
    question: 'How do you forecast demand, price, or behavior well enough to act on it?',
  },
  {
    variant: 'data' as const,
    label: 'Decision-ready data',
    question: 'How do you turn a large, messy, or incomplete dataset into a decision-ready model?',
  },
  {
    variant: 'validation' as const,
    label: 'Model confidence',
    question: 'How do you know a model is actually right, and how much should it be trusted?',
  },
];

const capabilities = [
  {
    index: '01',
    title: 'Optimization & Decision Systems',
    description:
      'Formulating constraints, objectives, and trade-offs into models that support real decisions under scarcity.',
  },
  {
    index: '02',
    title: 'Applied AI & Machine Learning',
    description:
      'Building and evaluating models — from classification to recommendation — grounded in how the underlying data was generated.',
  },
  {
    index: '03',
    title: 'Analytics & Business Intelligence',
    description:
      'Turning operational and market data into dashboards and metrics that hold up under scrutiny.',
  },
  {
    index: '04',
    title: 'Mathematical & Computational Modeling',
    description:
      "Using differential equations, numerical methods, and simulation to study systems that don't have closed-form answers.",
  },
  {
    index: '05',
    title: 'Forecasting & Planning',
    description:
      'Structuring uncertain futures — markets, demand, behavior — into models that support planning, not just prediction.',
  },
  {
    index: '06',
    title: 'Data Products & Visualization',
    description:
      'Turning models and analysis into interpretable, decision-ready visual tools.',
  },
];

const allProjects = await getCollection('work');

const ohioHousing = allProjects.find((p) => p.id === 'ohio-housing-affordability-analysis')!;
const fer = allProjects.find((p) => p.id === 'facial-emotion-recognition')!;
const amazonRec = allProjects.find((p) => p.id === 'amazon-product-recommendation-system')!;

const allResearch = await getCollection('research');

const researchPreviewSlugs = [
  'newton-fd-method-nonlinear-interface',
  'covid-19-vaccine-uptake-behavior',
  'crime-cooperative-policing-model',
  'green-roofs-urban-heat-island',
];
const researchPreview = researchPreviewSlugs
  .map((slug) => allResearch.find((r) => r.id === slug))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));
const researchMeta: Record<string, { variant: 'nfdm' | 'vaccine' | 'policing' | 'greenroof'; question: string }> = {
  'newton-fd-method-nonlinear-interface': {
    variant: 'nfdm',
    question: 'What happens when a smooth numerical solution meets a nonlinear interface jump?',
  },
  'covid-19-vaccine-uptake-behavior': {
    variant: 'vaccine',
    question: 'What changes when vaccine uptake is modeled as a strategic behavioral choice, not a given?',
  },
  'crime-cooperative-policing-model': {
    variant: 'policing',
    question: 'How does cooperation between police units change the predicted dynamics of crime?',
  },
  'green-roofs-urban-heat-island': {
    variant: 'greenroof',
    question: "How much cooling holds up when a green roof is tested against a full heat-transfer model?",
  },
};
---

<BaseLayout
  title="Sarah G. Randol — Applied Mathematics, Optimization & AI"
  description="A digital home for advanced analytical thinking: mathematics, optimization, data science, and AI applied to real organizational decisions."
>
  <!-- Hero -->
  <section class="hero section--dark">
    <div class="hero__layout">
      <div class="hero__copy">
        <h1 class="hero__identity">A digital home for<br class="hero__identity-break" /> advanced analytical thinking.</h1>
        <p class="hero__headline">
          Turning complex problems into decisions you can act on.
        </p>
        <p class="hero__subhead text-muted prose-width">
          I build mathematical models, optimization systems, and applied AI tools that help
          organizations structure ambiguity, forecast what's coming, and make better decisions
          with the data they already have.
        </p>
      </div>
      <div class="hero__visual">
        <HeroDecisionPath />
      </div>
    </div>
  </section>

  <!-- Analytical thinking in practice -->
  <section class="section section--tight analytical-practice">
    <div class="container">
      <SectionHeading
        eyebrow="Where analysis becomes useful"
        title="Analytical thinking in practice"
        description="Analytical work earns its keep when organizations have to decide anyway — under real constraints, incomplete information, uncertainty, or a model that might be wrong."
      />
      <div class="analytical-practice__grid">
        {analyticalModules.map((mod) => (
          <AnalyticalModule variant={mod.variant} label={mod.label} question={mod.question} />
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities at a glance -->
  <section id="capabilities" class="section section--tight section--blue-tint capabilities">
    <div class="container">
      <SectionHeading
        eyebrow="Capabilities at a glance"
        title="The analytical toolkit"
        
      />
      <CapabilityMosaic capabilities={capabilities} />
    </div>
  </section>

  <!-- Evidence in practice -->
  <section class="section section--tight section--lavender-tint evidence">
    <div class="container">
      <SectionHeading
        eyebrow="Selected work"
        title="Where analysis becomes tangible"
        
      />
      <div class="evidence-grid">
        <a class="evidence-card evidence-card--feature" href={`/work/${ohioHousing.id}/`}>
          <div class="evidence-card__visual evidence-card__visual--choropleth" aria-hidden="true">
            <svg viewBox="0 0 200 120" preserveAspectRatio="xMidYMid slice">
              <g fill="currentColor" stroke="none">
                <rect x="6" y="6" width="34" height="32" rx="3" opacity="0.25" />
                <rect x="44" y="6" width="34" height="32" rx="3" opacity="0.4" />
                <rect x="82" y="6" width="34" height="32" rx="3" opacity="0.3" />
                <rect x="120" y="6" width="34" height="32" rx="3" opacity="0.5" />
                <rect x="158" y="6" width="34" height="32" rx="3" opacity="0.2" />
                <rect x="6" y="42" width="34" height="32" rx="3" opacity="0.35" />
                <rect x="44" y="42" width="34" height="32" rx="3" opacity="0.22" />
                <rect x="120" y="42" width="34" height="32" rx="3" opacity="0.3" />
                <rect x="158" y="42" width="34" height="32" rx="3" opacity="0.45" />
                <rect x="6" y="78" width="34" height="32" rx="3" opacity="0.4" />
                <rect x="44" y="78" width="34" height="32" rx="3" opacity="0.28" />
                <rect x="82" y="78" width="34" height="32" rx="3" opacity="0.35" />
                <rect x="120" y="78" width="34" height="32" rx="3" opacity="0.22" />
                <rect x="158" y="78" width="34" height="32" rx="3" opacity="0.4" />
              </g>
              <rect x="82" y="42" width="34" height="32" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </div>
          <div class="evidence-card__body">
            <p class="evidence-card__tag">Decision analysis</p>
            <h3 class="evidence-card__curiosity">Statewide averages say Ohio's rent burden is moderate. County-level data tells a more complicated story.</h3>
            <p class="evidence-card__context text-muted">An interactive Power BI analysis of rent, income, and affordability across Ohio counties (2019–2023), with a county-level deep dive.</p>
            <span class="evidence-card__action">Explore the analysis</span>
          </div>
        </a>

        <a class="evidence-card evidence-card--square" href={`/work/${fer.id}/`}>
          {fer.data.thumbnail && (
            <div class="evidence-card__visual evidence-card__visual--photo">
              <img src={fer.data.thumbnail} alt="" loading="lazy" />
            </div>
          )}
          <div class="evidence-card__body">
            <p class="evidence-card__tag">Computer vision</p>
            <h3 class="evidence-card__curiosity">When does a smile stop looking like happiness to a model?</h3>
            <p class="evidence-card__context text-muted">Comparing convolutional neural-network approaches for classifying facial emotion from grayscale images.</p>
            <span class="evidence-card__action">See how the models compared</span>
          </div>
        </a>

        <a class="evidence-card evidence-card--tall" href={`/work/${amazonRec.id}/`}>
          <div class="evidence-card__visual evidence-card__visual--matrix" aria-hidden="true">
            <svg viewBox="0 0 140 200" preserveAspectRatio="xMidYMid slice">
              <g fill="currentColor">
                <circle cx="20" cy="20" r="3" opacity="0.15" /><circle cx="45" cy="20" r="3" opacity="0.8" />
                <circle cx="70" cy="20" r="3" opacity="0.15" /><circle cx="95" cy="20" r="3" opacity="0.15" />
                <circle cx="20" cy="45" r="3" opacity="0.15" /><circle cx="45" cy="45" r="3" opacity="0.15" />
                <circle cx="70" cy="45" r="3" opacity="0.8" /><circle cx="95" cy="45" r="3" opacity="0.15" />
                <circle cx="20" cy="70" r="3" opacity="0.8" /><circle cx="45" cy="70" r="3" opacity="0.15" />
                <circle cx="70" cy="70" r="3" opacity="0.15" /><circle cx="95" cy="70" r="3" opacity="0.15" />
                <circle cx="20" cy="95" r="3" opacity="0.15" /><circle cx="45" cy="95" r="3" opacity="0.15" />
                <circle cx="70" cy="95" r="3" opacity="0.15" /><circle cx="95" cy="95" r="3" opacity="0.8" />
              </g>
              <g stroke="currentColor" stroke-width="1" opacity="0.4" fill="none">
                <line x1="45" y1="20" x2="60" y2="140" />
                <line x1="70" y1="45" x2="60" y2="155" />
                <line x1="20" y1="70" x2="60" y2="170" />
                <line x1="95" y1="95" x2="60" y2="140" />
              </g>
              <g fill="currentColor">
                <rect x="30" y="135" width="60" height="8" rx="2" opacity="0.7" />
                <rect x="30" y="150" width="42" height="8" rx="2" opacity="0.5" />
                <rect x="30" y="165" width="28" height="8" rx="2" opacity="0.35" />
              </g>
            </svg>
          </div>
          <div class="evidence-card__body">
            <p class="evidence-card__tag">Recommendation systems</p>
            <h3 class="evidence-card__curiosity">What does a useful recommendation require when user signals are sparse?</h3>
            <p class="evidence-card__context text-muted">Comparing collaborative-filtering methods for ranking products from incomplete interaction data.</p>
            <span class="evidence-card__action">Explore the recommendation system</span>
          </div>
        </a>
      </div>
      <div class="section-cta">
        <Button href="/work/" variant="ghost">View all work</Button>
      </div>
    </div>
  </section>

  <!-- Research preview -->
  <section class="section section--tight research-preview">
    <div class="container">
      <SectionHeading
        eyebrow="Research"
        title="Research preview"
        
      />
      <div class="research-preview__grid">
        {researchPreview.map((item) => (
          <article class="research-preview__item">
            <a class="research-preview__link" href={`/research/${item.id}/`}>
              <div class:list={['research-preview__circle', `research-preview__circle--${researchMeta[item.id].variant}`]}>
                <ResearchPreviewCircle variant={researchMeta[item.id].variant} />
              </div>
              <p class="research-preview__domain">{item.data.tags[0]}</p>
              <h3 class="research-preview__title">{item.data.title}</h3>
              <p class="research-preview__question">{researchMeta[item.id].question}</p>
              <span class="research-preview__action">Read the research</span>
            </a>
          </article>
        ))}
      </div>
      <div class="section-cta">
        <Button href="/research/" variant="ghost">Explore all research</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 4vw + 1rem, 4.5rem) clamp(1.75rem, 2.5vw + 1rem, 3rem);
  }

  .hero__layout {
    position: relative;
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__identity {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    color: var(--text-on-dark);
  }

  .hero__identity-break {
    display: none;
  }

  .hero__headline {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--accent-primary-on-dark);
  }

  .hero__subhead {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 20rem;
    max-height: 16rem;
    margin-inline: auto;
    opacity: 0.85;
  }

  /* Analytical thinking in practice */
  .analytical-practice__grid {
    display: grid;
    gap: var(--space-8) var(--space-6);
    grid-template-columns: 1fr;
  }

  /* Selected work */
  .evidence-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  .evidence-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .evidence-card:hover,
  .evidence-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .evidence-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .evidence-card__visual {
    aspect-ratio: 16 / 8;
    background: var(--surface-muted);
    overflow: hidden;
    color: var(--accent-primary);
  }

  .evidence-card__visual svg,
  .evidence-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .evidence-card--square .evidence-card__visual {
    aspect-ratio: 1 / 1;
  }

  .evidence-card--tall .evidence-card__visual {
    aspect-ratio: 4 / 5;
  }

  .evidence-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .evidence-card__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .evidence-card__curiosity {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--text-on-paper);
  }

  .evidence-card--feature .evidence-card__curiosity {
    font-size: var(--text-lg);
    max-width: 34rem;
  }

  .evidence-card__context {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .evidence-card__action {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .evidence-card:hover .evidence-card__action {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .section-cta {
    margin-top: var(--space-8);
  }

  /* Research preview */
  .research-preview__grid {
    display: grid;
    gap: var(--space-8) var(--space-5);
    grid-template-columns: 1fr;
  }

  .research-preview__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .research-preview__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .research-preview__circle {
    width: 100%;
    max-width: 13rem;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface);
    padding: 12%;
    margin-bottom: var(--space-2);
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .research-preview__link:hover .research-preview__circle,
  .research-preview__link:focus-visible .research-preview__circle {
    box-shadow: 0 0 0 4px var(--border-strong);
    transform: translateY(-2px);
  }

  .research-preview__domain {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted-on-paper);
  }

  .research-preview__title {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--text-on-paper);
  }

  .research-preview__link:hover .research-preview__title,
  .research-preview__link:focus-visible .research-preview__title {
    color: var(--accent);
  }

  .research-preview__question {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted-on-paper);
    max-width: 22rem;
  }

  .research-preview__action {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }

  .research-preview__link:hover .research-preview__action,
  .research-preview__link:focus-visible .research-preview__action {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Tablet */
  @media (min-width: 640px) {
    .analytical-practice__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .research-preview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 900px) {
    .hero__identity-break {
      display: inline;
    }

    .hero__layout {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-10);
    }

    .hero__visual {
      max-width: none;
      max-height: 30rem;
      margin-inline: 0;
    }

    .analytical-practice__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .research-preview__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .evidence-grid {
      grid-template-columns: repeat(4, 1fr);
      align-items: start;
    }

    .evidence-card--feature {
      grid-column: 1 / 3;
    }

    .evidence-card--square {
      grid-column: 3 / 4;
    }

    .evidence-card--tall {
      grid-column: 4 / 5;
    }
  }
</style>
