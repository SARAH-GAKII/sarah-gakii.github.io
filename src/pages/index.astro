---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import AnalyticalModule from '../components/home/AnalyticalModule.astro';
import CapabilityMosaic from '../components/home/CapabilityMosaic.astro';
import ResearchPreviewCircle from '../components/home/ResearchPreviewCircle.astro';

const analyticalModules = [
  {
    variant: 'forecasting' as const,
    label: 'Forecasting under uncertainty',
    question: 'How do you forecast demand, price, or behavior well enough to act on it?',
  },
  {
    variant: 'data' as const,
    label: 'Decision-ready data',
    question: 'How do you turn a large, messy, or incomplete dataset into a decision-ready model?',
  },
  {
    variant: 'validation' as const,
    label: 'Model confidence',
    question: 'How do you know a model is actually right, and how much should it be trusted?',
  },
  {
    variant: 'allocation' as const,
    label: 'Investment & allocation',
    question: 'Which markets, assets, or projects deserve investment when resources and time are limited?',
  },
];

const capabilities = [
  {
    index: '02',
    title: 'Applied AI & Machine Learning',
    description:
      'Building and evaluating models — from classification to recommendation — grounded in how the underlying data was generated.',
  },
  {
    index: '03',
    title: 'Analytics & Business Intelligence',
    description:
      'Turning operational and market data into dashboards and metrics that hold up under scrutiny.',
  },
  {
    index: '04',
    title: 'Mathematical & Computational Modeling',
    description:
      "Using differential equations, numerical methods, and simulation to study systems that don't have closed-form answers.",
  },
  {
    index: '05',
    title: 'Forecasting & Planning',
    description:
      'Structuring uncertain futures — markets, demand, behavior — into models that support planning, not just prediction.',
  },
  {
    index: '06',
    title: 'Data Products & Visualization',
    description:
      'Turning models and analysis into interpretable, decision-ready visual tools.',
  },
  {
    index: '01',
    title: 'Optimization & Decision Systems',
    description:
      'Formulating constraints, objectives, and trade-offs into models that support real decisions under scarcity.',
  },
];

const allProjects = await getCollection('work');

const ohioRealEstate = allProjects.find((p) => p.id === 'ohio-real-estate-opportunity-index')!;
const fer = allProjects.find((p) => p.id === 'facial-emotion-recognition')!;
const amazonRec = allProjects.find((p) => p.id === 'amazon-product-recommendation-system')!;

const allResearch = await getCollection('research');

const researchPreviewSlugs = [
  'newton-fd-method-nonlinear-interface',
  'crime-cooperative-policing-model',
  'covid-19-vaccine-uptake-behavior',
  'green-roofs-urban-heat-island',
];
const researchPreview = researchPreviewSlugs
  .map((slug) => allResearch.find((r) => r.id === slug))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));
const researchMeta: Record<string, { variant: 'nfdm' | 'vaccine' | 'policing' | 'greenroof'; question: string }> = {
  'newton-fd-method-nonlinear-interface': {
    variant: 'nfdm',
    question: 'What happens when a smooth numerical solution meets a nonlinear interface jump?',
  },
  'covid-19-vaccine-uptake-behavior': {
    variant: 'vaccine',
    question: 'What changes when vaccine uptake is modeled as a strategic behavioral choice, not a given?',
  },
  'crime-cooperative-policing-model': {
    variant: 'policing',
    question: 'How does cooperation between police units change the predicted dynamics of crime?',
  },
  'green-roofs-urban-heat-island': {
    variant: 'greenroof',
    question: "How much cooling holds up when a green roof is tested against a full heat-transfer model?",
  },
};

// Reuses the exact same local media already used for each project on the
// Research page itself (see src/pages/research/index.astro for video
// overrides, and each project's content frontmatter for its thumbnail) —
// nothing new was generated. Circles fall back to the abstract
// ResearchPreviewCircle motif for any future preview entry that has
// neither, so the container works regardless of what a given project has.
type ResearchPreviewMedia =
  | { type: 'video'; src: string }
  | { type: 'image'; src: string; alt?: string; objectPosition?: string };
const researchPreviewMedia: Record<string, ResearchPreviewMedia> = {
  'newton-fd-method-nonlinear-interface': { type: 'video', src: '/media/research/bridge-interface-teaser.mp4' },
  'covid-19-vaccine-uptake-behavior': { type: 'video', src: '/media/research/epidemic-network-teaser.mp4' },
  'crime-cooperative-policing-model': { type: 'image', src: '/images/research/city-chess.png' },
  'green-roofs-urban-heat-island': {
    type: 'image',
    src: '/images/research/urban-green-roof.png',
    objectPosition: '65% 45%',
  },
};
---

<BaseLayout
  title="Sarah G. Randol — Applied Mathematics, Optimization & AI"
  description="A digital home for advanced analytical thinking: mathematics, optimization, data science, and AI applied to real organizational decisions."
>
  <!-- Hero -->
  <section class="hero section--dark">
    <div class="hero__layout">
      <div class="hero__copy">
        <h1 class="hero__identity">A digital home for<br class="hero__identity-break" /> advanced analytical thinking.</h1>
        <p class="hero__headline">
          Turning complex problems into decisions you can act on.
        </p>
        <p class="hero__subhead text-muted prose-width">
          I build mathematical models, optimization systems, and applied AI tools that help
          organizations structure ambiguity, forecast what's coming, and make better decisions
          with the data they already have.
        </p>
      </div>
      <div class="hero__visual">
        <video
          class="hero__visual-video"
          src="/media/home/analytical-thinking-hero.mp4"
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          tabindex="-1"
          aria-hidden="true"
        ></video>
      </div>
    </div>
  </section>

  <!-- Analytical thinking in practice -->
  <section class="section section--tight analytical-practice">
    <div class="container">
      <SectionHeading
        eyebrow="Where analysis becomes useful"
        title="Analytical thinking in practice"
        description="Analytical work earns its keep when organizations have to decide anyway, under real constraints, incomplete information, uncertainty, or a model that might be wrong."
      />
      <div class="analytical-practice__grid">
        {analyticalModules.map((mod) => (
          <AnalyticalModule variant={mod.variant} label={mod.label} question={mod.question} />
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities at a glance -->
  <section id="capabilities" class="section section--tight section--blue-tint capabilities">
    <div class="container">
      <SectionHeading
        eyebrow="Capabilities at a glance"
        title="The analytical toolkit"
        
      />
      <CapabilityMosaic capabilities={capabilities} />
    </div>
  </section>

  <!-- Evidence in practice -->
  <section class="section section--tight section--lavender-tint evidence">
    <div class="container">
      <SectionHeading
        eyebrow="Selected work"
        title="Where analysis becomes tangible"
        
      />
      <div class="evidence-grid">
        <a class="evidence-card" href={`/work/${ohioRealEstate.id}/`}>
          <div class="evidence-card__visual evidence-card__visual--choropleth" aria-hidden="true">
            <img src="/images/home/opportunity-index-grid.png" alt="" loading="lazy" />
          </div>
          <div class="evidence-card__body">
            <p class="evidence-card__tag">Investment analysis</p>
            <h3 class="evidence-card__curiosity">Which Ohio counties actually look strongest once every signal is weighed together?</h3>
            <p class="evidence-card__context text-muted">A weighted, county-level index comparing investment potential across all 88 Ohio counties.</p>
            <span class="evidence-card__action">Explore the opportunity index</span>
          </div>
        </a>

        <a class="evidence-card" href={`/work/${fer.id}/`}>
          <div class="evidence-card__visual evidence-card__visual--face" aria-hidden="true">
            <img src="/images/home/facial-emotion-recognition-visual.png" alt="" loading="lazy" />
          </div>
          <div class="evidence-card__body">
            <p class="evidence-card__tag">Computer vision</p>
            <h3 class="evidence-card__curiosity">Can a model tell what a face is expressing, or only what it looks like?</h3>
            <p class="evidence-card__context text-muted">Comparing convolutional neural-network approaches for classifying facial emotion from grayscale images.</p>
            <span class="evidence-card__action">See how the models compared</span>
          </div>
        </a>

        <a class="evidence-card" href={`/work/${amazonRec.id}/`}>
          <div class="evidence-card__visual evidence-card__visual--network" aria-hidden="true">
            <img src="/images/home/recommendation-signal-inference.png" alt="" loading="lazy" />
          </div>
          <div class="evidence-card__body">
            <p class="evidence-card__tag">Recommendation systems</p>
            <h3 class="evidence-card__curiosity">What does a useful recommendation require when user signals are sparse?</h3>
            <p class="evidence-card__context text-muted">Comparing collaborative-filtering methods for ranking products from incomplete interaction data.</p>
            <span class="evidence-card__action">Explore the recommendation system</span>
          </div>
        </a>
      </div>
      <div class="section-cta">
        <Button href="/work/" variant="ghost">View all work</Button>
      </div>
    </div>
  </section>

  <!-- Research preview -->
  <section class="section section--tight research-preview">
    <div class="container">
      <SectionHeading
        eyebrow="Research"
        title="Research preview"
        
      />
      <div class="research-preview__grid">
        {researchPreview.map((item) => {
          const media = researchPreviewMedia[item.id];
          return (
            <article class="research-preview__item">
              <a class="research-preview__link" href={`/research/${item.id}/`}>
                <div
                  class:list={[
                    'research-preview__circle',
                    `research-preview__circle--${researchMeta[item.id].variant}`,
                    media && 'research-preview__circle--media',
                  ]}
                >
                  {media?.type === 'video' ? (
                    <video
                      src={media.src}
                      autoplay
                      muted
                      loop
                      playsinline
                      disablepictureinpicture
                      preload="metadata"
                      tabindex="-1"
                      aria-hidden="true"
                    />
                  ) : media?.type === 'image' ? (
                    <img
                      src={media.src}
                      alt={media.alt ?? ''}
                      loading="lazy"
                      style={media.objectPosition ? `object-position: ${media.objectPosition}` : undefined}
                    />
                  ) : (
                    <ResearchPreviewCircle variant={researchMeta[item.id].variant} />
                  )}
                </div>
                <p class="research-preview__domain">{item.data.tags[0]}</p>
                <h3 class="research-preview__title">{item.data.title}</h3>
                <p class="research-preview__question">{researchMeta[item.id].question}</p>
                <span class="research-preview__action">Read the research</span>
              </a>
            </article>
          );
        })}
      </div>
      <div class="section-cta">
        <Button href="/research/" variant="ghost">Explore all research</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Hero video: plays continuously (native `loop`) for as long as the hero
  // remains in view. Muted/no controls throughout; this is the hero's
  // visual artwork, not a media player.
  //
  // Playback is driven entirely by IntersectionObserver + document
  // visibility, not by the native `autoplay` attribute (deliberately
  // omitted from the markup) — that keeps "only play while actually in
  // view" an absolute guarantee rather than something racing against the
  // browser's own autoplay timing. `loop` still handles restarting at the
  // end of each cycle on its own; no `ended` handling is needed for that.
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero__visual-video');
  const heroPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heroVideo && !heroPrefersReducedMotion) {
    let isInView = false;

    heroVideo.muted = true;

    const playSafely = () => {
      heroVideo.play().catch(() => {
        // Autoplay can still be refused; the video just stays on its
        // current frame — no error surfaced, no retry.
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const [entry] = entries;
          isInView = entry.isIntersecting;
          if (isInView) {
            if (!document.hidden) playSafely();
          } else {
            heroVideo.pause(); // currentTime untouched — resumes from here
          }
        },
        { threshold: 0.5 }
      );
      observer.observe(heroVideo);
    } else {
      // No IntersectionObserver support: fall back to always-in-view.
      isInView = true;
      playSafely();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        heroVideo.pause();
      } else if (isInView) {
        playSafely();
      }
    });
  }
</script>

<script>
  // Same left-to-right stagger-reveal philosophy as the Analytical Toolkit
  // section, applied independently here: its own container, its own
  // IntersectionObserver, its own "run once" state. Kept as a small,
  // self-contained duplicate rather than a shared utility module — the
  // toolkit's already-working implementation is left untouched, and two
  // short, independent copies are simpler than an abstraction built for
  // only two call sites.
  //
  // The entrance class/transform is applied to .research-preview__item
  // (the outer <article>, one per research entry) rather than the circle
  // or link inside it, so a future <img>/<video> dropped into the circle
  // just moves along with its parent — the animation never touches or
  // assumes anything about the circle's contents.
  //
  // Run-once lifetime: intentionally scoped to this single script
  // execution only (the `observer` const and the "has it fired" state
  // live purely in this closure + the live DOM's classList). Nothing is
  // written to localStorage/sessionStorage/cookies, so a full reload —
  // even one that lands with this section already scrolled into view via
  // browser scroll restoration — always starts a fresh observer with no
  // memory of any previous page instance, and the double rAF below still
  // guarantees a painted "before" frame first. The result: replay-proof
  // within one page load, but always eligible again after a refresh.
  //
  // Each item is observed individually (not just the grid as a whole).
  // Observing only the container meant "is the container 25% visible"
  // could be satisfied by item 1 alone whenever the row is taller than
  // the viewport — e.g. reloading with scroll restored partway down a
  // wrapped/stacked layout — which revealed every item at once even
  // though items 2–4 were still off-screen, so their transition ran (and
  // finished) before the user ever scrolled to see it. Watching each
  // item's own visibility means an item only reveals once it is actually
  // in view, while the existing per-item transition-delay still gives
  // the same left-to-right stagger whenever items do become visible together.
  const researchGrid = document.querySelector<HTMLElement>('.research-preview__grid');
  const researchPrefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (researchGrid && !researchPrefersReducedMotion && 'IntersectionObserver' in window) {
    // Double rAF: guarantees the pre-entrance (opacity: 0) state is
    // painted at least once before the observer can react, so there's
    // always something to visibly transition from — see the Analytical
    // Toolkit section for the full explanation of why this matters.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        researchGrid.classList.add('js-animate');

        const items = researchGrid.querySelectorAll<HTMLElement>('.research-preview__item');
        let revealedCount = 0;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
                revealedCount += 1;
                if (revealedCount === items.length) observer.disconnect();
              }
            });
          },
          { threshold: 0.25, rootMargin: '0px 0px -10% 0px' }
        );

        items.forEach((item) => observer.observe(item));
      });
    });
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 4vw + 1rem, 4.5rem) clamp(1.75rem, 2.5vw + 1rem, 3rem);
  }

  .hero__layout {
    position: relative;
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero__identity {
    /* Scoped override of --text-display (not a token edit — that token
       has no other consumers, but keeping this local avoids any future
       ambiguity): same clamp shape, min bound (mobile) left untouched,
       max bound (desktop) reduced ~8.7% so the headline doesn't dominate
       the now-larger hero visualization as much. */
    font-size: clamp(3rem, 2.2rem + 3.4vw, 5.15rem);
    line-height: var(--leading-tight);
    color: var(--text-on-dark);
  }

  .hero__identity-break {
    display: none;
  }

  .hero__headline {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--accent-primary-on-dark);
  }

  .hero__subhead {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: min(100%, 24rem);
    max-height: 25rem;
    margin-inline: -1.25rem;
    opacity: 0.85;
  }

  .hero__visual-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Softens the video's own opaque rectangular edge into the hero
       background rather than the file itself needing to change: the
       center stays fully clear, and only the outer perimeter fades to
       transparent, letting the hero's own background show through. */
    mask-image: radial-gradient(ellipse closest-side at center, black 60%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse closest-side at center, black 60%, transparent 100%);
  }

  /* Analytical thinking in practice */
  .analytical-practice__grid {
    display: grid;
    gap: var(--space-8) var(--space-6);
    grid-template-columns: 1fr;
  }

  /* Selected work */
  .evidence-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .evidence-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base), transform var(--transition-base),
      flex-basis 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .evidence-card:hover,
  .evidence-card:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .evidence-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .evidence-card__visual {
    aspect-ratio: 16 / 8;
    background: var(--surface-muted);
    overflow: hidden;
    color: var(--accent-primary);
  }

  .evidence-card__visual svg,
  .evidence-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* FER photograph: faded to a pale lavender wash so the face and its
     landmark overlay read as soft/atmospheric rather than a dominant
     photograph, matching the abstract illustrations beside it. The face
     sits in the right two-thirds of the source frame, so object-position
     is biased right (rather than center) to keep it in frame at the
     narrower compact-card widths where the crop is horizontal. */
  .evidence-card__visual--face {
    position: relative;
  }

  .evidence-card__visual--face img {
    object-position: 75% 42%;
    filter: saturate(0.6) brightness(1.05) contrast(0.9);
  }

  .evidence-card__visual--face::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--surface-lavender-tint);
    opacity: 0.4;
    pointer-events: none;
  }

  .evidence-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .evidence-card__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .evidence-card__curiosity {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--text-on-paper);
    transition: font-size 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .evidence-card__context {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .evidence-card__action {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .evidence-card:hover .evidence-card__action {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .section-cta {
    margin-top: var(--space-8);
  }

  /* Research preview */
  .research-preview__grid {
    display: grid;
    gap: var(--space-8) var(--space-5);
    grid-template-columns: 1fr;
  }

  .research-preview__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .research-preview__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .research-preview__circle {
    width: 100%;
    max-width: 13rem;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface);
    padding: 12%;
    margin-bottom: var(--space-2);
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  /* Photo/video previews fill the circle edge-to-edge rather than sitting
     inset like the abstract line-art motif, so the 12% padding above is
     removed only for this variant. */
  .research-preview__circle--media {
    padding: 0;
  }

  .research-preview__circle img,
  .research-preview__circle video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .research-preview__link:hover .research-preview__circle,
  .research-preview__link:focus-visible .research-preview__circle {
    box-shadow: 0 0 0 4px var(--border-strong);
    transform: translateY(-2px);
  }

  .research-preview__domain {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted-on-paper);
  }

  .research-preview__title {
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--text-on-paper);
  }

  .research-preview__link:hover .research-preview__title,
  .research-preview__link:focus-visible .research-preview__title {
    color: var(--accent);
  }

  .research-preview__question {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted-on-paper);
    max-width: 22rem;
  }

  .research-preview__action {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
  }

  .research-preview__link:hover .research-preview__action,
  .research-preview__link:focus-visible .research-preview__action {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Entrance: each complete research item (circle, domain, title,
     question, link — everything inside the <article>) moves as one unit.
     Scoped under .js-animate so the un-enhanced/no-JS state is simply the
     grid's normal, fully visible layout above.

     The transition lives on .is-visible (the target state), not on the
     hidden base rule — see the Analytical Toolkit section for the full
     explanation. In short: putting it on the hidden rule instead makes
     adding .js-animate itself kick off a transition FROM the default
     visible state, which is invisible when the row is below the fold
     (it finishes long before the user scrolls there) but breaks the
     animation if the row is already in view on load — e.g. a reload that
     restores scroll position — because .is-visible then interrupts that
     fade-out moments later, collapsing it into an imperceptible flicker
     instead of a real entrance.

     transition-delay is scoped to the same .is-visible-qualified selector
     as the rest of the transition (rather than a separate, unqualified
     :nth-child rule) so all four transition sub-properties activate
     together, atomically, per item — nothing for an item to inherit
