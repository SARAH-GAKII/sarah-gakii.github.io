---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';
import HoverPlayVideo from '../../components/shared/HoverPlayVideo.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work — Sarah G. Randol"
  description="Completed analytics, optimization, machine learning, and mathematical modeling projects — evidence of capability, not claims."
>
  <PageHero
    eyebrow="Work"
    title="Analytical work, applied"
    description="A collection of analytical projects built to solve real problems using mathematics, optimization, AI, and data."
    motif="optimization"
  />

  <section class="section section--lavender-tint work-projects">
    <div class="container">
      <div class="work-grid">
        {projects.map((project) => (
          <ProjectCard
            slug={project.id}
            title={project.data.title}
            summary={project.data.summary}
            methods={project.data.methods}
            status={project.data.status}
            thumbnail={project.data.thumbnail}
            video={project.data.video}
            forceVideo={project.id === 'facial-emotion-recognition'}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<HoverPlayVideo />

<style>
  .work-projects {
    padding-block: clamp(1.5rem, 2.5vw + 1rem, 3rem) clamp(2.5rem, 4vw + 1rem, 4.5rem);
  }

  .work-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
</style>
