---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import { contactLinks } from '../../data/about';

const paths = [
  {
    audience: 'Hiring managers & recruiters',
    description: 'Evidence of how I structure ambiguous problems and ship analytical work that holds up.',
  },
  {
    audience: 'Business leaders & collaborators',
    description: 'A partner for analytics, optimization, or AI work tied to a real operational decision.',
  },
  {
    audience: 'Technical reviewers',
    description: 'Methodology, assumptions, and validation available on request for any project shown on this platform.',
  },
];
---

<BaseLayout
  title="Contact — Sarah G. Randol"
  description="Get in touch about a role, a project, or the methodology behind any work on this platform."
>
  <PageHero
    eyebrow="Contact"
    title="Have a problem worth structuring carefully?"
    description="Reach out about a role, a project, or a question about the methodology behind any work shown on this platform."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-links">
        <a class="contact-link" href={`mailto:${contactLinks.email}`}>
          <span class="contact-link__label">Email</span>
          <span class="contact-link__value">{contactLinks.email}</span>
        </a>
        <a class="contact-link" href={contactLinks.linkedin} target="_blank" rel="noopener">
          <span class="contact-link__label">LinkedIn</span>
          <span class="contact-link__value">linkedin.com/in/sarah-gakii</span>
        </a>
        <a class="contact-link" href={contactLinks.github} target="_blank" rel="noopener">
          <span class="contact-link__label">GitHub</span>
          <span class="contact-link__value">github.com/SARAH-GAKII</span>
        </a>
      </div>

      <div class="engagement-paths">
        {paths.map((path) => (
          <article class="engagement-path">
            <h3>{path.audience}</h3>
            <p class="text-muted">{path.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="container contact-cta">
      <Button href={`mailto:${contactLinks.email}`}>Email me</Button>
      <Button href={contactLinks.linkedin} variant="secondary" external>Connect on LinkedIn</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-8);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base);
  }

  .contact-link:hover {
    border-color: var(--accent);
  }

  .contact-link__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted-on-paper);
  }

  .contact-link__value {
    font-family: var(--font-serif);
    font-size: var(--text-md);
  }

  .engagement-paths {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .engagement-path {
    padding: var(--space-5) var(--space-6);
    border-left: 2px solid var(--accent);
  }

  .engagement-path h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .engagement-path p {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 720px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
