---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ResearchCard from '../../components/cards/ResearchCard.astro';
import HoverPlayVideo from '../../components/shared/HoverPlayVideo.astro';

const items = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

// Per-item media overrides: research entries that use a video visualization
// instead of the default static thumbnail, keyed by content-collection slug.
interface ResearchMedia {
  video: string;
  orientation?: 'horizontal';
  mediaFit?: 'contain';
}
const researchMedia: Record<string, ResearchMedia> = {
  'covid-19-vaccine-uptake-behavior': { video: '/media/research/epidemic-network-teaser.mp4' },
  'newton-fd-method-nonlinear-interface': { video: '/media/research/bridge-interface-teaser.mp4' },
  'academic-workshops-research-schools': {
    video: '/media/research/presentation-teaser.mp4',
    orientation: 'horizontal',
    mediaFit: 'contain',
  },
};
---

<BaseLayout
  title="Research — Sarah G. Randol"
  description="Published and graduate research in PDEs, numerical analysis, epidemic modeling, and dynamical systems, plus academic workshops and research schools."
>
  <PageHero
    eyebrow="Research"
    title="Mathematical & computational research"
    description="Research developed through graduate coursework, published collaboration, and intensive modeling workshops, spanning partial differential equations, numerical analysis, epidemic modeling, and dynamical systems."
    motif="network"
  />

  <section class="section section--blue-tint research-projects">
    <div class="container">
      <div class="research-grid">
        {items.map((item) => {
          const media = researchMedia[item.id];
          return media ? (
            <ResearchCard
              slug={item.id}
              title={item.data.title}
              summary={item.data.summary}
              tags={item.data.tags}
              thumbnail={item.data.thumbnail}
              orientation={media.orientation}
              mediaFit={media.mediaFit}
            >
              <video
                slot="media"
                src={media.video}
                muted
                loop
                playsinline
                preload="metadata"
                disablepictureinpicture
                controlslist="nodownload noplaybackrate nofullscreen"
                tabindex="-1"
                aria-hidden="true"
              ></video>
            </ResearchCard>
          ) : (
            <ResearchCard
              slug={item.id}
              title={item.data.title}
              summary={item.data.summary}
              tags={item.data.tags}
              thumbnail={item.data.thumbnail}
            />
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<HoverPlayVideo />

<style>
  .research-projects {
    padding-block: clamp(1.5rem, 2.5vw + 1rem, 3rem) clamp(2.5rem, 4vw + 1rem, 4.5rem);
  }

  .research-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }
</style>
